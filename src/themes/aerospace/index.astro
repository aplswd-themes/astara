    <title>Aerospace | Next-Gen Space & Aviation</title>
    <meta name="description" content="A premium aerospace and deep space technology theme built with Astro and Tailwind CSS." />
  </head>
  <body class="bg-black text-white antialiased selection:bg-cyan-500/30">
    <LandingPage client:load />
  </body>
</html>
