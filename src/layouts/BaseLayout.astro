---
/**
 * BaseLayout.astro
 * ─────────────────
 * Root HTML shell for all pages. Handles meta, fonts, global CSS.
 *
 * Props:
 * @prop title      - Page <title> tag
 * @prop description - Meta description (for SEO)
 * @prop themeSlug  - One of: 'saas' | 'agency' | 'ecommerce' | 'health' | 'restaurant'
 *                    Loads the matching theme CSS file.
 * @prop ogImage    - Optional Open Graph image URL
 */
import '../styles/global.css';
import { MotionStoryboardPipeline } from '../components/interactive/MotionStoryboardPipeline';

interface Props {
  title: string;
  description?: string;
  themeSlug?: 'saas' | 'agency' | 'ecommerce' | 'health' | 'restaurant';
  ogImage?: string;
}

const {
  title,
  description = 'A beautiful, customizable website theme.',
  themeSlug,
  ogImage = '/og-default.png',
} = Astro.props;

// Map slug to font import URL
const themeFonts: Record<string, string> = {
  saas:       'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap',
  agency:     'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&family=Inter:wght@400;500;600&display=swap',
  ecommerce:  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap',
  health:     'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap',
  restaurant: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;0,800;1,600&family=Inter:wght@400;500&display=swap',
};

const fontHref = themeSlug ? themeFonts[themeSlug] : themeFonts.ecommerce;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts — preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />

    <!-- Theme-specific CSS custom properties injected via inline style block -->
    {themeSlug === 'saas' && (
      <style>{`
        :root {
          --color-primary: #6366f1; --color-primary-dark: #4f46e5; --color-primary-light: #a5b4fc;
          --color-accent: #8b5cf6; --color-accent-dark: #7c3aed;
          --color-bg: #0a0a0f; --color-bg-subtle: #111118; --color-bg-muted: #1a1a2e;
          --color-border: #1e1e2e; --color-border-strong: #2a2a3e;
          --color-text: #f1f5f9; --color-text-muted: #94a3b8; --color-text-subtle: #64748b; --color-text-inverse: #0a0a0f;
          --font-heading: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
          --font-body: 'Inter', system-ui, sans-serif;
        }
      `}</style>
    )}
    {themeSlug === 'agency' && (
      <style>{`
        :root {
          --color-primary: #f97316; --color-primary-dark: #ea580c; --color-primary-light: #fed7aa;
          --color-accent: #1e293b; --color-accent-dark: #0f172a;
          --color-bg: #fffbf7; --color-bg-subtle: #f8f4f0; --color-bg-muted: #f0ebe4;
          --color-border: #e8e0d8; --color-border-strong: #d4c9bc;
          --color-text: #1a0a00; --color-text-muted: #6b5a4e; --color-text-subtle: #9e8878; --color-text-inverse: #fffbf7;
          --font-heading: 'Playfair Display', 'Georgia', serif;
          --font-body: 'Inter', system-ui, sans-serif;
        }
      `}</style>
    )}
    {themeSlug === 'ecommerce' && (
      <style>{`
        :root {
          --color-primary: #10b981; --color-primary-dark: #059669; --color-primary-light: #a7f3d0;
          --color-accent: #f59e0b; --color-accent-dark: #d97706;
          --color-bg: #ffffff; --color-bg-subtle: #f9fafb; --color-bg-muted: #f3f4f6;
          --color-border: #e5e7eb; --color-border-strong: #d1d5db;
          --color-text: #111827; --color-text-muted: #6b7280; --color-text-subtle: #9ca3af; --color-text-inverse: #ffffff;
          --font-heading: 'Inter', system-ui, sans-serif;
          --font-body: 'Inter', system-ui, sans-serif;
        }
      `}</style>
    )}
    {themeSlug === 'health' && (
      <style>{`
        :root {
          --color-primary: #0891b2; --color-primary-dark: #0e7490; --color-primary-light: #a5f3fc;
          --color-accent: #6ee7b7; --color-accent-dark: #34d399;
          --color-bg: #f0fdfa; --color-bg-subtle: #e6f8f5; --color-bg-muted: #ccfbf1;
          --color-border: #99f6e4; --color-border-strong: #5eead4;
          --color-text: #042f2e; --color-text-muted: #115e59; --color-text-subtle: #0f766e; --color-text-inverse: #f0fdfa;
          --font-heading: 'DM Sans', 'Inter', system-ui, sans-serif;
          --font-body: 'DM Sans', system-ui, sans-serif;
        }
      `}</style>
    )}
    {themeSlug === 'restaurant' && (
      <style>{`
        :root {
          --color-primary: #dc2626; --color-primary-dark: #b91c1c; --color-primary-light: #fca5a5;
          --color-accent: #d97706; --color-accent-dark: #b45309;
          --color-bg: #0c0a09; --color-bg-subtle: #1c1917; --color-bg-muted: #292524;
          --color-border: #3c3330; --color-border-strong: #57534e;
          --color-text: #faf5f0; --color-text-muted: #d6ccc2; --color-text-subtle: #a8998e; --color-text-inverse: #0c0a09;
          --font-heading: 'Cormorant Garamond', 'Georgia', serif;
          --font-body: 'Inter', system-ui, sans-serif;
        }
      `}</style>
    )}
  </head>
  <body>
    <MotionStoryboardPipeline client:load />
    <slot />
  </body>
</html>
