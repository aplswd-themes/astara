---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { 
    label: 'About', 
    href: '/about',
    children: [
      { label: 'About (Main)', href: '/about' },
      { label: 'Minimalist v1', href: '/about-v1' },
      { label: 'Creative v2', href: '/about-v2' },
      { label: 'Dark Tech v3', href: '/about-v3' },
      { label: 'Editorial v4', href: '/about-v4' },
    ]
  },
  { 
    label: 'Services', 
    href: '/services',
    children: [
      { label: 'Services (Main)', href: '/services' },
      { label: 'Minimalist v1', href: '/services-v1' },
      { label: 'Creative v2', href: '/services-v2' },
      { label: 'Dark Tech v3', href: '/services-v3' },
      { label: 'Editorial v4', href: '/services-v4' },
    ]
  },
  { 
    label: 'Pricing', 
    href: '/pricing',
    children: [
      { label: 'Pricing (Main)', href: '/pricing' },
      { label: 'Minimalist v1', href: '/pricing-v1' },
      { label: 'Creative v2', href: '/pricing-v2' },
      { label: 'Dark Tech v3', href: '/pricing-v3' },
      { label: 'Editorial v4', href: '/pricing-v4' },
    ]
  },
  { label: 'Docs', href: '/docs' },
  { label: 'Contact', href: '/contact' },
];

const subnavLinks = [
  {
    title: 'Platform',
    links: [
      { label: 'Enterprise Architecture', href: '#' },
      { label: 'Security & Compliance', href: '#' },
      { label: 'Edge Network (CDN)', href: '#' },
      { label: 'Global Availability', href: '#' }
    ]
  },
  {
    title: 'Themes',
    links: [
      { label: 'SaaS Software', href: '/themes/saas' },
      { label: 'Creative Agency', href: '/themes/agency' },
      { label: 'Retail Store', href: '/themes/ecommerce' },
      { label: 'Health Portal', href: '/themes/health' }
    ]
  },
  {
    title: 'Documentation',
    links: [
      { label: 'Component Library', href: '/docs' },
      { label: 'CSS Variable Tokens', href: '/docs#theme-tokens' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' }
    ]
  }
];
---

<BaseLayout
  title="About Us — Nexus"
  description="We empower modern businesses with smart, scalable digital solutions."
  themeSlug="agency"
>
  <PreviewNavbar client:load variationName="About Us (Main)" />

  <main class="bg-zinc-50 overflow-hidden selection:bg-indigo-500/30 font-sans antialiased text-zinc-900 pb-20">
    {/* Modern Hero Header Section */}
    <section class="relative pt-32 pb-24 px-6 overflow-hidden border-b border-zinc-200/50">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 via-white to-fuchsia-50/30 -z-10"></div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-12">
          
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-zinc-200 text-indigo-700 text-[11px] font-bold uppercase tracking-widest mb-8 shadow-sm ring-1 ring-black/5">
              <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
              Current Layout
            </div>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter text-zinc-900 mb-6 leading-[1.05]">
              About Us <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">(Main)</span>
            </h1>
            <p class="text-xl sm:text-2xl font-medium text-zinc-500 leading-relaxed max-w-2xl">
              We build digital spaces that command attention. Pragmatic engineering met with technical precision.
            </p>
          </div>
          
          {/* Variations Nav Card within Header */}
          <div class="flex-shrink-0 w-full md:w-72 bg-white/80 backdrop-blur-xl p-6 rounded-3xl border border-zinc-200/80 shadow-2xl shadow-indigo-900/5 ring-1 ring-black/5">
            <h3 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-4 px-1">Layout Variations</h3>
            <div class="flex flex-col gap-2">
              <a href="/about" class="px-4 py-3 rounded-xl bg-zinc-900 text-white text-xs font-bold transition-all shadow-md shadow-zinc-900/20 flex justify-between items-center group border border-zinc-800">
                About (Main) <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
              <a href="/about-v1" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Minimalist v1 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/about-v2" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Creative v2 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/about-v3" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Dark Tech v3 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/about-v4" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Editorial v4 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    {/* Philosophy / Story Bento Grid */}
    <section class="py-24 px-6 relative z-10">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          {/* Main Visual */}
          <div class="lg:col-span-8 group relative rounded-[2rem] overflow-hidden bg-zinc-200 aspect-video lg:aspect-auto shadow-2xl shadow-zinc-200/50">
            <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2000&auto=format&fit=crop" alt="Abstract geometry" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-105" />
            <div class="absolute inset-0 bg-indigo-900/10 mix-blend-overlay group-hover:bg-indigo-900/30 transition-colors duration-700"></div>
          </div>

          {/* Text Block */}
          <div class="lg:col-span-4 bg-zinc-900 rounded-[2rem] p-10 lg:p-12 text-white flex flex-col justify-center relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-64 h-64 bg-fuchsia-500/20 blur-[100px] rounded-full group-hover:bg-fuchsia-500/40 transition-colors duration-700"></div>
            <h2 class="text-3xl font-bold mb-6 tracking-tight relative z-10">Visual communication.</h2>
            <p class="text-zinc-400 text-lg leading-relaxed mb-10 relative z-10">
              Aesthetics serve function. We build interfaces that guide users naturally, removing friction while maintaining distinct visual character.
            </p>
            <div class="relative z-10 mt-auto">
              <a href="#work" class="inline-flex items-center gap-3 font-semibold text-white hover:text-fuchsia-400 transition-colors group/link">
                View our capabilities
                <span class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center group-hover/link:border-fuchsia-400 group-hover/link:translate-x-2 transition-all">
                  &rarr;
                </span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Team Section */}
    <section class="py-32 px-6 bg-white border-y border-zinc-200">
      <div class="max-w-7xl mx-auto">
        <div class="mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8">
          <div>
            <h2 class="text-5xl font-black tracking-tight mb-4">The Collective</h2>
            <p class="text-zinc-500 text-xl max-w-lg">A multidisciplinary team of designers, engineers, and strategists.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { name: 'Sarah Jenkins', role: 'Partner, Design', image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800&auto=format&fit=crop' },
            { name: 'David Chen', role: 'Engineering Lead', image: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop' },
            { name: 'Marcus Williams', role: 'Creative Director', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=800&auto=format&fit=crop' },
            { name: 'Elena Rodriguez', role: 'Head of Operations', image: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=800&auto=format&fit=crop' }
          ].map((member, i) => (
            <div class="group cursor-pointer">
              <div class="aspect-[4/5] rounded-3xl overflow-hidden mb-6 relative bg-zinc-100">
                <img src={member.image} alt={member.name} class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
              </div>
              <h3 class="text-xl font-bold tracking-tight">{member.name}</h3>
              <p class="text-zinc-500 font-medium">{member.role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Metrics / Final CTA */}
    <section class="py-32 px-6 bg-zinc-950 text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(99,102,241,0.15)_0,transparent_100%)]"></div>
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-12 border-b border-white/10 pb-20 mb-20">
          <div>
            <div class="text-5xl md:text-7xl font-black mb-2 tracking-tighter text-indigo-400">12+</div>
            <div class="text-zinc-400 font-medium">Years in Business</div>
          </div>
          <div>
            <div class="text-5xl md:text-7xl font-black mb-2 tracking-tighter text-fuchsia-400">150</div>
            <div class="text-zinc-400 font-medium">Projects Shipped</div>
          </div>
          <div>
            <div class="text-5xl md:text-7xl font-black mb-2 tracking-tighter text-emerald-400">40M</div>
            <div class="text-zinc-400 font-medium">Users Reached</div>
          </div>
          <div>
            <div class="text-5xl md:text-7xl font-black mb-2 tracking-tighter text-amber-400">0</div>
            <div class="text-zinc-400 font-medium">Compromises</div>
          </div>
        </div>
        
        <div class="text-center">
          <h2 class="text-4xl md:text-6xl font-black tracking-tighter mb-8">Ready to start?</h2>
          <button class="bg-white text-zinc-950 px-8 py-4 rounded-full text-lg font-bold hover:bg-indigo-50 transition-colors shadow-lg">
            Book an Introduction
          </button>
        </div>
      </div>
    </section>

  </main>

  <Footer
    brandName="Nexus"
    brandDescription="High-performance Astro architecture for digital agencies and modern retail."
    subnavLinks={subnavLinks}
    socialLinks={[
      { platform: 'Twitter', href: '#' },
      { platform: 'GitHub', href: '#' },
      { platform: 'LinkedIn', href: '#' }
    ]}
  />
</BaseLayout>



