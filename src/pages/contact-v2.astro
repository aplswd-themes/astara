---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

const contactVariants = [
  { label: 'Contact (Main)', href: '/contact' },
  { label: 'Minimalist v1', href: '/contact-v1' },
  { label: 'Creative v2', href: '/contact-v2' },
  { label: 'Dark Tech v3', href: '/contact-v3' }
];

const footerColumns = [{ title: 'Company', links: [{ label: 'About Us', href: '/about' }] }];
---

<BaseLayout title="Contact - Creative" themeSlug="ecommerce">
  <PreviewNavbar client:load variationName="Creative v2" variations={contactVariants} />

  <main class="flex-1 bg-indigo-50/50 overflow-hidden font-sans pb-32 relative">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-300 rounded-full mix-blend-multiply filter blur-[100px] opacity-40 animate-blob"></div>
    <div class="absolute top-40 left-0 w-[500px] h-[500px] bg-pink-300 rounded-full mix-blend-multiply filter blur-[100px] opacity-40 animate-blob animation-delay-2000"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-32 relative z-10">
      <div class="text-center mb-20">
        <h1 class="text-6xl md:text-8xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 mb-6 pb-2">
          Say Hello.
        </h1>
        <p class="text-xl text-slate-600 font-medium max-w-2xl mx-auto">We'd love to hear from you. Drop us a line and we'll get back to you within 24 hours.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Floating Info Cards -->
        <div class="flex flex-col gap-8">
          <div class="bg-white/80 backdrop-blur-xl p-8 rounded-[3rem] shadow-xl shadow-indigo-900/5 hover:-translate-y-2 transition-transform duration-500 border border-white">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-indigo-400 to-purple-400 text-white flex items-center justify-center mb-6 shadow-lg shadow-purple-500/30">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Email</h3>
            <p class="text-slate-500 font-medium mb-4">hello@nexus.com</p>
          </div>
          
          <div class="bg-white/80 backdrop-blur-xl p-8 rounded-[3rem] shadow-xl shadow-indigo-900/5 hover:-translate-y-2 transition-transform duration-500 border border-white ml-0 lg:ml-12">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-pink-400 to-rose-400 text-white flex items-center justify-center mb-6 shadow-lg shadow-pink-500/30">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Phone</h3>
            <p class="text-slate-500 font-medium mb-4">+1 555 0123</p>
          </div>
        </div>

        <!-- Soft Form -->
        <div class="bg-white rounded-[3rem] p-10 md:p-14 shadow-2xl shadow-purple-900/10 border border-white relative z-20">
          <form class="flex flex-col gap-6">
            <div>
              <label class="block text-sm font-bold text-slate-700 mb-2 pl-4">Your Name</label>
              <input type="text" class="w-full bg-slate-50 border-none rounded-full px-6 py-4 text-slate-900 font-medium focus:ring-4 focus:ring-purple-500/20 transition-all placeholder-slate-400" placeholder="Jane Doe" />
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-700 mb-2 pl-4">Email Address</label>
              <input type="email" class="w-full bg-slate-50 border-none rounded-full px-6 py-4 text-slate-900 font-medium focus:ring-4 focus:ring-purple-500/20 transition-all placeholder-slate-400" placeholder="jane@example.com" />
            </div>
            <div>
              <label class="block text-sm font-bold text-slate-700 mb-2 pl-4">Message</label>
              <textarea rows="4" class="w-full bg-slate-50 border-none rounded-[2rem] px-6 py-4 text-slate-900 font-medium focus:ring-4 focus:ring-purple-500/20 transition-all placeholder-slate-400 resize-none" placeholder="What's on your mind?"></textarea>
            </div>
            <button type="button" class="mt-4 w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white font-bold text-lg rounded-full py-4 shadow-lg shadow-purple-500/25 hover:shadow-xl hover:scale-[1.02] transition-all">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer columns={footerColumns} />
</BaseLayout>