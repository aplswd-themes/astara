---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';
import { PricingTable } from '../components/sections/PricingTable';
import { FAQ } from '../components/sections/FAQ';
import CTABanner from '../components/sections/CTABanner.astro';
import LogoCloud from '../components/sections/LogoCloud.astro';

import { globalNavLinks as navLinks } from '../lib/nav';

const pricingVariants = [{label:'Pricing (Main)',href:'/pricing'},{label:'Minimalist v1',href:'/pricing-v1'},{label:'Creative v2',href:'/pricing-v2'},{label:'Dark Tech v3',href:'/pricing-v3'},{label:'Editorial v4',href:'/pricing-v4'}];

const plans = [
  {
    name: 'Starter',
    description: 'Perfect for indie hackers, creators, and small projects getting started.',
    monthlyPrice: 19,
    annualPrice: 14,
    features: [
      'Up to 3 active websites',
      'All 18+ pre-built components',
      'Community Discord & forum access',
      'Automatic SSL & edge delivery',
      'Standard email support',
    ],
    cta: 'Get Started with Starter',
    ctaHref: '/contact',
  },
  {
    name: 'Professional',
    description: 'Designed for high-growth agencies, startups, and expanding businesses.',
    monthlyPrice: 49,
    annualPrice: 36,
    features: [
      'Unlimited website projects',
      'All 5 niche templates included',
      'Priority code reviews & updates',
      'Advanced analytics & A/B test setup',
      'Same-day priority support',
      'Commercial license for client work',
    ],
    cta: 'Start 14-Day Free Trial',
    ctaHref: '/contact',
    popular: true,
  },
  {
    name: 'Enterprise',
    description: 'Dedicated infrastructure, custom SLAs, and tailored architectural support.',
    monthlyPrice: 'Custom' as const,
    annualPrice: 'Custom' as const,
    features: [
      'Custom bespoke component creation',
      'Dedicated Slack/Teams channel',
      'Guaranteed 99.99% uptime SLA',
      'Security audit & SOC2 compliance docs',
      'Tailored onboarding & staff training',
    ],
    cta: 'Speak with Enterprise Team',
    ctaHref: '/contact',
  },
];

const pricingFaqs = [
  {
    question: 'Can I switch between monthly and annual plans at any time?',
    answer: 'Yes, you can upgrade, downgrade, or switch billing frequency directly from your billing portal at any time. Prorated credits are automatically calculated and applied.',
  },
  {
    question: 'Do you offer a refund policy?',
    answer: 'We provide a 14-day money-back guarantee with zero friction. If the templates or components do not fit your project architecture, simply reach out to support for a complete refund.',
  },
  {
    question: 'Are there hidden fees, bandwidth charges, or seat limits?',
    answer: 'No hidden fees whatsoever. What you see is what you pay. Starter and Pro tiers include commercial rights to build and deploy without additional per-seat licensing fees.',
  },
  {
    question: 'Can I purchase these themes for client projects?',
    answer: 'Yes! Our Professional and Enterprise tiers include royalty-free licenses allowing you to create unlimited client sites without re-purchasing licenses.',
  },
];

const clientLogos = [
  { name: 'Vercel' },
  { name: 'Stripe' },
  { name: 'Linear' },
  { name: 'GitHub' },
  { name: 'Figma' },
];

const footerColumns = [
  {
    title: 'Product',
    links: [
      { label: 'All Themes', href: '/' },
      { label: 'Components Docs', href: '/docs' },
      { label: 'Pricing Plans', href: '/pricing' },
      { label: 'Services', href: '/services' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Engineering Blog', href: '/blog' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Contact Support', href: '/contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ],
  },
];
---

<BaseLayout
  title="Transparent, Scalable Pricing â€” Nexus Astro System"
  description="Flexible pricing plans designed for freelancers, agencies, and hyper-growth tech teams."
  themeSlug="ecommerce"
>
    <PreviewNavbar client:load variationName="Pricing (Main)" variations={pricingVariants} />

  <main class="bg-zinc-50 overflow-hidden selection:bg-indigo-500/30 font-sans antialiased text-zinc-900 pb-20">
    {/* Modern Hero Header Section */}
    <section class="relative pt-32 pb-24 px-6 overflow-hidden border-b border-zinc-200/50">
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 via-white to-emerald-50/30 -z-10"></div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-12">
          
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-zinc-200 text-indigo-700 text-[11px] font-bold uppercase tracking-widest mb-8 shadow-sm ring-1 ring-black/5">
              <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
              Current Layout
            </div>
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter text-zinc-900 mb-6 leading-[1.05]">
              Simple <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-emerald-500">Pricing</span>
            </h1>
            <p class="text-xl sm:text-2xl font-medium text-zinc-500 leading-relaxed max-w-2xl">
              Choose the plan that matches your current scale. Every tier includes access to production-tested components and continuous updates.
            </p>
          </div>
          
          {/* Variations Nav Card within Header */}
          <div class="flex-shrink-0 w-full md:w-72 bg-white/80 backdrop-blur-xl p-6 rounded-3xl border border-zinc-200/80 shadow-2xl shadow-indigo-900/5 ring-1 ring-black/5">
            <h3 class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-4 px-1">Layout Variations</h3>
            <div class="flex flex-col gap-2">
              <a href="/pricing" class="px-4 py-3 rounded-xl bg-zinc-900 text-white text-xs font-bold transition-all shadow-md shadow-zinc-900/20 flex justify-between items-center group border border-zinc-800">
                Pricing (Main) <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
              <a href="/pricing-v1" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Minimalist v1 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/pricing-v2" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Creative v2 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/pricing-v3" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Dark Tech v3 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
              <a href="/pricing-v4" class="px-4 py-3 rounded-xl bg-white border border-zinc-200 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 text-xs font-bold transition-all flex justify-between items-center group">
                Editorial v4 <span class="group-hover:translate-x-1 transition-transform text-zinc-300">→</span>
              </a>
            </div>
          </div>
          
        </div>
      </div>
    </section>

  <!-- Pricing Table Component -->
  <PricingTable
    client:load
    title="Select your development tier"
    subtitle="Plans & Inclusions"
    plans={plans}
  />

  <!-- Social proof -->
  <LogoCloud label="Trusted by engineering and design leaders at" logos={clientLogos} />

  <!-- FAQ Section -->
  <FAQ
    client:load
    title="Frequently Asked Billing Questions"
    subtitle="Need Clarity?"
    items={pricingFaqs}
  />

  <!-- Final CTA -->
  <CTABanner
    headline="Ready to build your next client website in minutes?"
    subheadline="Join over 15,000 developers shipping faster with clean Astro and Tailwind templates."
    primaryCta={{ label: 'Get Started Today', href: '/contact' }}
    secondaryCta={{ label: 'Explore Components Docs', href: '/docs' }}
    variant="primary"
  />
  </main>

  <Footer
    logo="Nexus"
    tagline="Modern, multi-niche web architecture built with Astro, React, and Tailwind CSS."
    columns={footerColumns}
  />
</BaseLayout>


