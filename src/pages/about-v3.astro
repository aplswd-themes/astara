---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
---
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About v3 - Tech</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-zinc-300 font-sans antialiased">`n  <PreviewNavbar client:load variationName="Dark Tech v3" />
  <div class="max-w-6xl mx-auto px-4 py-20">
    <div class="mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        System Status: Optimal
      </div>
      <h1 class="text-5xl font-medium text-zinc-100 tracking-tight mb-6">
        Infrastructure for the modern web.
      </h1>
      <p class="text-xl text-zinc-400 max-w-2xl">
        We engineer high-performance primitives that power global scale applications. Built for developers who demand reliability.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-[250px]">
      
      <!-- Large Item -->
      <div class="md:col-span-2 md:row-span-2 group relative rounded-2xl bg-zinc-900/50 border border-zinc-800/50 p-8 overflow-hidden hover:border-zinc-700 transition-colors">
        <div class="absolute inset-0 bg-gradient-to-br from-zinc-800/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative z-10 flex flex-col h-full justify-between">
          <div>
            <h3 class="text-2xl font-medium text-zinc-100 mb-2">Global Edge Network</h3>
            <p class="text-zinc-400 max-w-md">Compute closer to your users. Our distributed infrastructure ensures minimal latency worldwide.</p>
          </div>
          <div class="font-mono text-xs text-zinc-500 space-y-2">
            <div class="flex justify-between border-b border-zinc-800 pb-2">
              <span>Datacenters</span><span class="text-zinc-300">34 regions</span>
            </div>
            <div class="flex justify-between border-b border-zinc-800 pb-2">
              <span>Avg Latency</span><span class="text-zinc-300">&lt; 12ms</span>
            </div>
            <div class="flex justify-between pb-2">
              <span>Uptime</span><span class="text-zinc-300">99.999%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Small Item 1 -->
      <div class="group relative rounded-2xl bg-zinc-900/50 border border-zinc-800/50 p-6 overflow-hidden hover:border-zinc-700 transition-colors">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-1 bg-blue-500 shadow-[0_0_20px_rgba(59,130,246,0.5)] opacity-0 group-hover:opacity-100 transition-opacity rounded-b-full"></div>
        <h3 class="text-lg font-medium text-zinc-100 mb-2 mt-4">Type-Safe By Default</h3>
        <p class="text-sm text-zinc-400">End-to-end type safety across the entire stack. Catch errors at compile time.</p>
      </div>

      <!-- Small Item 2 -->
      <div class="group relative rounded-2xl bg-zinc-900/50 border border-zinc-800/50 p-6 overflow-hidden hover:border-zinc-700 transition-colors">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-1 bg-purple-500 shadow-[0_0_20px_rgba(168,85,247,0.5)] opacity-0 group-hover:opacity-100 transition-opacity rounded-b-full"></div>
        <h3 class="text-lg font-medium text-zinc-100 mb-2 mt-4">Zero Config</h3>
        <p class="text-sm text-zinc-400">Sensible defaults that scale. Deploy with a single command, no complex pipelines required.</p>
      </div>

      <!-- Wide Item -->
      <div class="md:col-span-3 group relative rounded-2xl bg-zinc-900/50 border border-zinc-800/50 p-8 overflow-hidden hover:border-zinc-700 transition-colors flex flex-col md:flex-row items-start md:items-center justify-between">
         <div>
            <h3 class="text-xl font-medium text-zinc-100 mb-2">Enterprise Security</h3>
            <p class="text-sm text-zinc-400 max-w-xl">SOC2 Type II compliant, encryption at rest, and automated vulnerability scanning. Security is built into the primitive layer.</p>
         </div>
         <a href="#" class="mt-4 md:mt-0 px-4 py-2 bg-zinc-100 text-zinc-900 rounded-lg text-sm font-medium hover:bg-white transition-colors">
            Read Security Docs
         </a>
      </div>

    </div>
  </div>
</body>
</html>



