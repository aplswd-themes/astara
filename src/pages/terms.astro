---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';

const privacyVariants = [
  { label: 'Privacy (Main)', href: '/privacy' },
  { label: 'Dark Mode Tech v2', href: '/privacy-v2' },
  { label: 'Terms of Service', href: '/terms' },
];
---

<BaseLayout themeSlug="software">
  <PreviewNavbar client:load variationName="Terms of Service" variations={privacyVariants} />
  
  <div class="bg-zinc-50 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      
      <header class="mb-16 border-b border-zinc-200 pb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-100/50 border border-indigo-200 mb-6">
          <span class="text-[10px] font-bold uppercase tracking-widest text-indigo-700">Legal Documentation</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight text-zinc-900 mb-6">Terms of Service</h1>
        <p class="text-xl text-zinc-500 font-medium max-w-2xl">Please read these terms carefully before using our platform. Last updated: January 15, 2024</p>
      </header>

      <div class="flex flex-col lg:flex-row gap-16 items-start">
        <!-- Sticky Sidebar Navigation -->
        <aside class="hidden lg:block w-64 flex-shrink-0 sticky top-32">
          <nav class="space-y-2 relative before:absolute before:inset-y-0 before:left-0 before:w-px before:bg-zinc-200">
            <a href="#section-1" class="block pl-4 py-1 text-sm font-semibold text-zinc-900 border-l-2 border-indigo-600 transition-colors">1. Acceptance of Terms</a>
            <a href="#section-2" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">2. Description of Service</a>
            <a href="#section-3" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">3. User Accounts</a>
            <a href="#section-4" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">4. Acceptable Use</a>
            <a href="#section-5" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">5. Intellectual Property</a>
            <a href="#section-6" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">6. Payment Terms</a>
            <a href="#section-7" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">7. Limitation of Liability</a>
            <a href="#section-8" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">8. Termination</a>
            <a href="#section-9" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">9. Governing Law</a>
            <a href="#section-10" class="block pl-4 py-1 text-sm font-medium text-zinc-500 hover:text-zinc-900 border-l-2 border-transparent transition-colors">10. Contact Information</a>
          </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 bg-white p-8 md:p-12 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-zinc-100">
          <div class="prose prose-lg prose-zinc max-w-none">
            
            <section id="section-1" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">1. Acceptance of Terms</h2>
              <p class="text-zinc-600 leading-relaxed">By accessing or using our services, you agree to be bound by these Terms of Service and all applicable laws and regulations. If you do not agree with any part of these terms, you are prohibited from using or accessing our platform.</p>
            </section>

            <section id="section-2" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">2. Description of Service</h2>
              <p class="text-zinc-600 leading-relaxed">Nexus provides a digital platform enabling users to build, manage, and scale their online presence. We reserve the right to modify, suspend, or discontinue any aspect of the service at any time without prior notice.</p>
            </section>

            <section id="section-3" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">3. User Accounts and Registration</h2>
              <p class="text-zinc-600 leading-relaxed">To access certain features, you must register for an account and provide accurate, current information. You are entirely responsible for maintaining the confidentiality of your account credentials and for all activities that occur under your account.</p>
            </section>

            <section id="section-4" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">4. Acceptable Use Policy</h2>
              <p class="text-zinc-600 leading-relaxed">You agree not to use our service for any unlawful purpose, to upload malicious code, or to engage in any activity that disrupts or interferes with our platform's performance. Violations of this policy may result in immediate account termination.</p>
            </section>

            <section id="section-5" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">5. Intellectual Property</h2>
              <p class="text-zinc-600 leading-relaxed">All content, features, and functionality available through the service, including text, graphics, logos, and software, are the exclusive property of Nexus or its licensors and are protected by international copyright and trademark laws.</p>
            </section>

            <section id="section-6" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">6. Payment Terms</h2>
              <p class="text-zinc-600 leading-relaxed">Subscription fees are billed in advance on a recurring basis as outlined in your selected plan. All payments are non-refundable unless otherwise specified in writing. We reserve the right to adjust pricing with prior notice.</p>
            </section>

            <section id="section-7" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">7. Limitation of Liability</h2>
              <p class="text-zinc-600 leading-relaxed">In no event shall Nexus, its directors, employees, or partners be liable for any indirect, incidental, special, or consequential damages arising out of or in connection with your use of the service or inability to use the service.</p>
            </section>

            <section id="section-8" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">8. Termination</h2>
              <p class="text-zinc-600 leading-relaxed">We may terminate or suspend your access to our service immediately, without prior notice or liability, for any reason whatsoever, including without limitation if you breach these Terms of Service.</p>
            </section>

            <section id="section-9" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">9. Governing Law</h2>
              <p class="text-zinc-600 leading-relaxed">These terms shall be governed by and construed in accordance with the laws of the jurisdiction in which Nexus operates, without regard to its conflict of law provisions.</p>
            </section>

            <section id="section-10" class="mb-12 scroll-mt-32">
              <h2 class="text-2xl font-bold text-zinc-900 mb-4 pb-2 border-b border-zinc-100">10. Contact Information</h2>
              <p class="text-zinc-600 leading-relaxed">If you have any questions or require clarification regarding these Terms of Service, please contact our legal department at <a href="mailto:legal@nexus.com" class="text-indigo-600 font-semibold hover:underline">legal@nexus.com</a>.</p>
            </section>

          </div>
        </main>
      </div>
    </div>
  </div>
  
  <Footer />
</BaseLayout>
