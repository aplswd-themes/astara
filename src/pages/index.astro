    },
    {
      name: 'Help & FAQ',
      path: '/faq',
      desc: 'Categorized accordion tabs for product & billing',
      badge: 'Knowledge',
      variations: [
        { label: 'Animated Split v2', path: '/faq-v2' },
        { label: 'Modern Grid v3', path: '/faq-v3' }
      ]
    },
    {
      name: 'Legal Pages',
      path: '/privacy',
      desc: 'Comprehensive GDPR/CCPA compliant policy layout',
      badge: 'Legal',
      variations: [
        { label: 'Dark Mode Tech v2', path: '/privacy-v2' },
        { label: 'Terms of Service', path: '/terms' },
      ]
    },
    {
      name: 'System Pages',
      path: '/docs',
      desc: 'Component docs, UI Kit, 404',
      badge: 'System',
      variations: [
        { label: 'UI Kit', path: '/ui-kit' },
        { label: '404 Error', path: '/404' },
      ]
    },
    {
      name: 'Component Showcase',
      path: '/components-showcase',
      desc: '5 Header and 5 Footer layout variations',
      badge: 'Components',
      variations: [
        { label: 'All Variations', path: '/components-showcase' },
      ]
    }
  ];

  const techRibbonItems = [
    { icon: '⚡', label: 'Astro 7 Core Engine', badge: 'Ultra Fast' },
    { icon: '⚛️', label: 'React 19 Islands', badge: 'Hydrated' },
    { icon: '🎨', label: 'Tailwind CSS v4', badge: 'Design Tokens' },
    { icon: '🛡️', label: 'TypeScript Strict', badge: '100% Type-Safe' },
    { icon: '✦', label: 'Zero AI Slop', badge: 'Production Grade' },
    { icon: '💎', label: '22+ Modular Components', badge: 'Documented' },
    { icon: '📱', label: 'Fluid Responsive UX', badge: 'Mobile-First' },
    { icon: '🚀', label: '100% Lighthouse Score', badge: 'Optimized' },
    { icon: '⚡', label: 'Astro 7 Core Engine', badge: 'Ultra Fast' },
    { icon: '⚛️', label: 'React 19 Islands', badge: 'Hydrated' },
    { icon: '🎨', label: 'Tailwind CSS v4', badge: 'Design Tokens' },
    { icon: '🛡️', label: 'TypeScript Strict', badge: '100% Type-Safe' },
    { icon: '✦', label: 'Zero AI Slop', badge: 'Production Grade' },
    { icon: '💎', label: '22+ Modular Components', badge: 'Documented' },
    { icon: '📱', label: 'Fluid Responsive UX', badge: 'Mobile-First' },
    { icon: '🚀', label: '100% Lighthouse Score', badge: 'Optimized' },
  ];

  const themesRibbonItems = [
    
    { icon: '✦', label: 'Forma Studio Agency', tag: 'High-End Editorial' },
    { icon: '🛒', label: 'Shopfront eCommerce', tag: 'Curated Retail' },
    { icon: '🏥', label: 'Vitality Health', tag: 'Longevity Clinic' },
    { icon: '🍽️', label: 'Saveur Gastronomy', tag: 'Michelin 3-Star' },
    { icon: '💼', label: '11+ Core Inner Pages', tag: 'About, Blog, FAQ, Legal' },
    { icon: '📊', label: 'Interactive Themes Sandbox', tag: 'Live Auto-Slider' },
    
    { icon: '✦', label: 'Forma Studio Agency', tag: 'High-End Editorial' },
    { icon: '🛒', label: 'Shopfront eCommerce', tag: 'Curated Retail' },
    { icon: '🏥', label: 'Vitality Health', tag: 'Longevity Clinic' },
    { icon: '🍽️', label: 'Saveur Gastronomy', tag: 'Michelin 3-Star' },
    { icon: '💼', label: '11+ Core Inner Pages', tag: 'About, Blog, FAQ, Legal' },
    { icon: '📊', label: 'Interactive Themes Sandbox', tag: 'Live Auto-Slider' },
  ];

  import { ModernArchitectureTree } from '../components/interactive/ModernArchitectureTree';
  import { SaasArchitectureTree } from '../components/interactive/SaasArchitectureTree';
  import { AgencyCreativePipelineTree } from '../components/interactive/AgencyCreativePipelineTree';
  import ProductionWorkflowTree from '../components/sections/ProductionWorkflowTree.astro';
  import { HubNavbar } from '../components/layout/HubNavbar';
  
  import { MEDIA } from '../lib/media';

  const themeGlowMap: Record<string, string> = {
    saas: 'hover:shadow-lg hover:shadow-indigo-500/10',
    agency: 'hover-glow-amber',
    ecommerce: 'hover-glow-emerald',
    health: 'hover-glow-purple',
    restaurant: 'hover-glow-rose',
    aerospace: 'hover-glow-cyan',
  };

  const themePhotoMap: Record<string, string> = {
    saas: MEDIA.saas.datacenter,
    agency: MEDIA.agency.studioSpace,
    ecommerce: MEDIA.ecommerce.heroPoster,
    health: MEDIA.health.clinicSanctuary,
    restaurant: MEDIA.restaurant.diningRoom,
      aerospace: MEDIA.aerospace.telemetry,
  };

  const themeRibbonMap: Record<string, { text: string; class: string }> = {
    saas: { text: '⚡ TOP DEV CHOICE', class: 'ribbon-saas' },
    agency: { text: '✦ EDITORIAL AWARDS', class: 'ribbon-agency' },
    ecommerce: { text: '🔥 3.8X CONVERSION', class: 'ribbon-ecommerce' },
    health: { text: '★ CLINICAL TRUST', class: 'ribbon-health' },
    restaurant: { text: '◈ MICHELIN 3-STAR', class: 'ribbon-restaurant' },
    aerospace: { text: '🚀 NEXT FRONTIER', class: 'ribbon-saas' },
  };
  ---

  <!doctype html>
  <html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astara — Multi-Purpose Astro & Tailwind Theme System</title>
    <meta name="description" content="A clean, highly customizable Astro 5 + React theme system with 5 niche homepages, 11+ inner page templates, and complete component documentation." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, sans-serif;
        background: #ffffff;
      color: #09090b;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      h1, h2, h3, h4, h5 {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      a { text-decoration: none; color: inherit; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col relative selection:bg-indigo-500 selection:text-zinc-900">

    <!-- Top Announcement Bar -->
    <div class="bg-indigo-50 border-b border-indigo-100 text-indigo-700 px-4 py-2 text-xs font-medium text-center relative z-50 backdrop-blur-sm">
      <span class="inline-flex items-center gap-1.5 font-bold text-zinc-900 bg-indigo-600 px-2 py-0.5 rounded-full text-[10px] mr-2 shadow-sm">NEW</span>
      Production-tested Astro 7 + React 19 theme architecture with zero bloat.
      <a href="/docs" class="underline text-indigo-200 hover:text-zinc-900 ml-2 font-semibold transition-colors">Explore Component Docs & CSS Tokens →</a>
    </div>

    <!-- Main Navigation Header with Sleek Responsive HubNavbar -->
    <HubNavbar client:load />

    <!-- Hero Section with Motion & Floating Elements -->
    <section class="relative pt-24 pb-20 px-6 overflow-hidden">
      <div class="max-w-5xl mx-auto text-center relative z-10">

        <!-- Glowing Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold mb-8  bg-indigo-50 text-indigo-700 border-indigo-200 shadow-sm bg-white border border-zinc-200 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>High-Performance Astro Framework Architecture</span>
          <span class="text-zinc-400">|</span>
          <span class="text-zinc-400">Zero AI Slop Guaranteed</span>
        </div>

        <!-- Main Headline with Gradient Text -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-zinc-900 mb-8 leading-[1.1] animate-fade-in-up">
          One clean design system.<br />
          <span class="text-zinc-900">
            Infinite niche possibilities.
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-zinc-400 max-w-3xl mx-auto mb-12 leading-relaxed animate-fade-in-up delay-100">
          Empower any client, startup, or agency to launch high-converting websites. Includes 5 niche homepages, 11+ production-ready inner pages, and unified CSS variable theming.
        </p>

        <!-- Primary Action Buttons -->
        <div class="flex flex-wrap justify-center items-center gap-4 mb-6 animate-fade-in-up delay-200">
          <a
            href="/downloads/themekit-astro-theme.zip"
            download="themekit-astro-theme.zip"
            class="download-btn px-8 py-4 rounded-xl font-bold text-sm bg-gradient-to-r from-emerald-600 to-teal-600 text-zinc-900 hover:opacity-95 shadow-xl shadow-emerald-600/30 transition-all hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Astro Code (.ZIP)</span>
          </a>
          <a
            href="#interactive-preview"
            class="px-8 py-4 rounded-xl font-bold text-sm bg-gradient-to-r from-indigo-600 to-purple-600 text-zinc-900 hover:opacity-95 shadow-xl shadow-indigo-600/30 transition-all hover:-translate-y-0.5 flex items-center gap-2"
          >
            <span>Launch Interactive Theme Sandbox</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/docs"
            class="px-8 py-4 rounded-xl font-bold text-sm border border-zinc-200 bg-zinc-50 text-zinc-600 hover:border-zinc-500 hover:text-zinc-900 transition-all backdrop-blur-sm"
          >
            Explore Component HTML/React Docs
          </a>
        </div>

        <div class="animate-fade-in-up delay-300 mb-20 flex justify-center">
          <a href="/components-showcase" class="inline-flex items-center gap-2 text-sm font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-6 py-3 rounded-full transition-colors border border-indigo-200 shadow-sm">
            <span class="animate-pulse">✨</span> View Header & Footer Variations Showcase &rarr;
          </a>
        </div>

        <!-- Floating Stats Dashboard Badges with Motion & Micro-Ribbons -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left animate-fade-in-up delay-300">
          <div class="p-5 rounded-2xl bg-white shadow-sm border border-zinc-200 hover:shadow-md transition-shadow interactive-card relative overflow-hidden border border-zinc-200 hover:border-zinc-300">
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xl font-black text-indigo-400">22+</span>
              <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-zinc-200">
                ✦ Modular
              </span>
            </div>
            <p class="text-xs font-bold text-zinc-900">Documented UI</p>
            <p class="text-[11px] text-zinc-400 mt-0.5">Strict typed props & documentation</p>
          </div>

          <div class="p-5 rounded-2xl bg-white shadow-sm border border-zinc-200 hover:shadow-md transition-shadow interactive-card relative overflow-hidden border border-zinc-200 hover:border-zinc-300">
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xl font-black text-purple-400">5</span>
              <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30">
                ⚡ Verticals
              </span>
            </div>
            <p class="text-xs font-bold text-zinc-900">Niche Homepages</p>
            <p class="text-[11px] text-zinc-400 mt-0.5">SaaS, Agency, Store, Clinic, Dining</p>
          </div>

          <div class="p-5 rounded-2xl bg-white shadow-sm border border-zinc-200 hover:shadow-md transition-shadow interactive-card relative overflow-hidden border border-zinc-200 hover:border-zinc-300">
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xl font-black text-emerald-400">11+</span>
              <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                â˜… Production
              </span>
            </div>
            <p class="text-xs font-bold text-zinc-900">Core Inner Pages</p>
            <p class="text-[11px] text-zinc-400 mt-0.5">About, Services, Pricing, Blog, Legal</p>
          </div>

          <div class="p-5 rounded-2xl bg-white shadow-sm border border-zinc-200 hover:shadow-md transition-shadow interactive-card relative overflow-hidden border border-zinc-200 hover:border-zinc-300">
            <div class="flex items-center justify-between mb-2">
              <span class="text-2xl font-black text-pink-400">100%</span>
              <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-pink-500/15 text-pink-300 border border-pink-500/30">
                â—ˆ CSS Tokens
              </span>
            </div>
            <p class="text-xs font-bold text-zinc-900">Variable Driven</p>
            <p class="text-[11px] text-zinc-400 mt-0.5">Instant one-file palette switching</p>
          </div>
        </div>

      </div>
    </section>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ DUAL-ANGLED MODERN 3D RIBBON MARQUEE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="ribbon-strip-container -my-4 z-20 pointer-events-auto">
      <!-- Ribbon 1: Angled -1.5deg with Indigo/Purple glow and Tech Pills -->
      <div class="ribbon-strip-angled-1 py-4 bg-white border-y border-zinc-200 shadow-sm overflow-hidden relative backdrop-blur-md">
        <div class="animate-marquee flex gap-8 items-center text-xs font-bold tracking-wider uppercase text-zinc-600">
          {techRibbonItems.map((item) => (
            <div class="flex items-center gap-3 shrink-0 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200 shadow-sm hover:border-zinc-300 hover:bg-zinc-50 transition-all cursor-default shadow-sm">
              <span class="text-sm">{item.icon}</span>
              <span class="text-zinc-900 font-semibold">{item.label}</span>
              <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-indigo-600 text-zinc-900 tracking-widest shadow-sm">
                {item.badge}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Ribbon 2: Angled +1.2deg with Orange/Gold glow running in reverse -->
      <div class="ribbon-strip-angled-2 py-3.5 -mt-2 bg-zinc-50 border-y border-zinc-200 shadow-sm overflow-hidden relative backdrop-blur-md">
        <div class="animate-marquee-reverse flex gap-8 items-center text-xs font-bold tracking-wider uppercase text-zinc-600">
          {themesRibbonItems.map((item) => (
            <div class="flex items-center gap-3 shrink-0 px-3.5 py-1.5 rounded-full bg-white border border-zinc-200 shadow-sm hover:border-zinc-300 hover:bg-zinc-50 transition-all cursor-default shadow-sm">
              <span class="text-sm">{item.icon}</span>
              <span class="text-zinc-900 font-semibold">{item.label}</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-orange-600/90 text-zinc-900 tracking-wider">
                {item.tag}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SPECIALIZED NICHE ARCHITECTURE TREES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <section class="py-24 px-6 max-w-7xl mx-auto w-full relative z-10 border-t border-zinc-200">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Industry Specific Modules</span>
        <h2 class="text-3xl sm:text-5xl font-black text-zinc-900 mt-1">Specialized Niche Architectures</h2>
        <p class="text-sm text-zinc-400 mt-3 leading-relaxed">
          Each theme comes with complex, data-driven interactive trees perfectly tailored to its industry, completely out of the box.
        </p>
      </div>

      <div class="space-y-24">
        <div>
          <h3 class="text-xl font-bold text-zinc-800 mb-6 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> SaaS Architecture Infrastructure</h3>
          <SaasArchitectureTree client:load />
        </div>
        
        <div>
          <h3 class="text-xl font-bold text-zinc-800 mb-6 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-orange-500"></span> Agency Creative Pipeline</h3>
          <AgencyCreativePipelineTree client:load />
        </div>
      </div>
    </section>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ INTERACTIVE LIVE THEME SWITCHER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <section id="interactive-preview" class="py-24 px-6 max-w-7xl mx-auto w-full relative z-10 border-t border-zinc-200">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Real-Time Demonstration</span>
        <h2 class="text-3xl sm:text-5xl font-black text-zinc-900 mt-1">Experience The Theme Switcher</h2>
        <p class="text-sm text-zinc-400 mt-3 leading-relaxed">
          Watch how our component library dynamically adapts color tokens, typography, and visual hierarchy across distinct business verticals without changing the underlying markup.
        </p>
      </div>

      <!-- Client-Loaded React Interactive Showcase -->
      <InteractiveThemeShowcase client:load />
    </section>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ COMPONENT & ARCHITECTURE TREE NAVIGATOR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <section id="architecture-tree" class="py-24 px-6 max-w-7xl mx-auto w-full border-t border-zinc-200 relative z-10">
      <ModernArchitectureTree client:load />
    </section>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ 5 NICHE LANDING PAGES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <section id="themes" class="py-24 px-6 max-w-7xl mx-auto w-full border-t border-zinc-200">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Full Template Releases</span>
          <h2 class="text-3xl sm:text-4xl font-black text-zinc-900 mt-1">4 Niche Landing Page Variants</h2>
          <p class="text-sm text-zinc-400 mt-2 max-w-xl leading-relaxed">
            Carefully tailored layouts featuring industry-specific conversion psychology, realistic copy, and cohesive styling.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-2.5 text-xs font-semibold text-zinc-400">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>All 5 Live & Accessible Now</span>
          </div>
          <a
            href="/downloads/themekit-astro-theme.zip"
            download="themekit-astro-theme.zip"
            data-theme-name="All 5 Themes Bundle"
            class="download-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600/20 text-indigo-300  hover:bg-indigo-600 hover:text-zinc-900 transition-all shadow-md"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download All Themes (.ZIP)</span>
          </a>
