  ---
  import { themes } from '../lib/themes';
  import '../styles/global.css';
  import { InteractiveThemeShowcase } from '../components/interactive/ThemeShowcase';
  import ThemeIcon from '../components/ui/ThemeIcon.astro';

  const corePages = [
    {
      name: 'About Us',
      path: '/about',
      desc: 'Team bios, mission statement, core values, company story',
      badge: 'Company',
      variations: [
        { label: 'Minimalist v1', path: '/about-v1' },
        { label: 'Creative v2', path: '/about-v2' },
        { label: 'Dark Tech v3', path: '/about-v3' },
        { label: 'Editorial v4', path: '/about-v4' },
      ]
    },
    {
      name: 'Services',
      path: '/services',
      desc: 'Service offerings, multi-step process, client reviews',
      badge: 'Solutions',
      variations: [
        { label: 'Minimalist v1', path: '/services-v1' },
        { label: 'Creative v2', path: '/services-v2' },
        { label: 'Dark Tech v3', path: '/services-v3' },
        { label: 'Editorial v4', path: '/services-v4' },
      ]
    },
    {
      name: 'Pricing Tiers',
      path: '/pricing',
      desc: 'Monthly/annual billing switcher, feature matrix, FAQ',
      badge: 'Conversion',
      variations: [
        { label: 'Minimalist v1', path: '/pricing-v1' },
        { label: 'Creative v2', path: '/pricing-v2' },
        { label: 'Dark Tech v3', path: '/pricing-v3' },
        { label: 'Editorial v4', path: '/pricing-v4' },
      ]
    },
    {
      name: 'Blog',
        path: '/blog',
        desc: 'Articles grid, category filters, author details',
        badge: 'Content',
        variations: [
          { label: 'Single Article', path: '/blog/future-of-ai-design' },
          { label: 'Minimalist v1', path: '/blog-v1' },
          { label: 'Creative v2', path: '/blog-v2' },
          { label: 'Dark Tech v3', path: '/blog-v3' },
          { label: 'Editorial v4', path: '/blog-v4' },
        ]
    },
    {
      name: 'Contact & Inquiries',
        path: '/contact',
        desc: 'Direct form inputs, interactive offices, quick contact',
        badge: 'Support',
        variations: [
          { label: 'Minimalist v1', path: '/contact-v1' },
          { label: 'Creative v2', path: '/contact-v2' },
          { label: 'Dark Tech v3', path: '/contact-v3' }
