---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

const contactVariants = [
  { label: 'Contact (Main)', href: '/contact' },
  { label: 'Minimalist v1', href: '/contact-v1' },
  { label: 'Creative v2', href: '/contact-v2' },
  { label: 'Dark Tech v3', href: '/contact-v3' }
];

const footerColumns = [{ title: 'Company', links: [{ label: 'About Us', href: '/about' }] }];
---

<BaseLayout title="Contact - Minimalist" themeSlug="ecommerce">
  <PreviewNavbar client:load variationName="Minimalist v1" variations={contactVariants} />

  <main class="flex-1 bg-gray-50 overflow-hidden font-sans pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <header class="mb-20">
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-gray-900 mb-6">Get in touch</h1>
        <p class="text-xl text-gray-500 max-w-2xl">We'd love to hear from you. Please fill out this form or shoot us an email.</p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Contact Info Side -->
        <div class="lg:col-span-4 flex flex-col gap-10 mt-4">
          <div class="relative pl-6 border-l-2 border-indigo-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-600 mb-2">Email</h3>
            <p class="text-xl font-medium text-gray-900 mb-1">hello@nexus.com</p>
            <p class="text-sm text-gray-500">24 hour response time</p>
          </div>
          <div class="relative pl-6 border-l-2 border-indigo-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-600 mb-2">Phone</h3>
            <p class="text-xl font-medium text-gray-900 mb-1">+1 555 0123</p>
            <p class="text-sm text-gray-500">Mon-Fri 9AM-6PM</p>
          </div>
          <div class="relative pl-6 border-l-2 border-indigo-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-600 mb-2">Office</h3>
            <p class="text-xl font-medium text-gray-900 mb-1">123 Innovation Drive<br/>SF, CA 94102</p>
          </div>
        </div>

        <!-- Modern Form -->
        <div class="lg:col-span-8 bg-white p-8 md:p-12 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100">
          <form class="flex flex-col gap-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="flex flex-col">
                <label class="text-sm font-semibold text-gray-700 mb-2">Full Name</label>
                <input type="text" placeholder="John Doe" class="bg-gray-50 border border-gray-200 rounded-xl px-5 py-4 text-gray-900 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 outline-none" />
              </div>
              <div class="flex flex-col">
                <label class="text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                <input type="email" placeholder="john@example.com" class="bg-gray-50 border border-gray-200 rounded-xl px-5 py-4 text-gray-900 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 outline-none" />
              </div>
            </div>
            <div class="flex flex-col">
              <label class="text-sm font-semibold text-gray-700 mb-2">Message</label>
              <textarea rows="5" placeholder="How can we help you?" class="bg-gray-50 border border-gray-200 rounded-xl px-5 py-4 text-gray-900 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 outline-none resize-none"></textarea>
            </div>
            <button type="button" class="mt-2 w-full sm:w-auto sm:self-start px-10 bg-indigo-600 text-white text-sm font-bold uppercase tracking-wide py-4 rounded-xl hover:bg-indigo-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer columns={footerColumns} />
</BaseLayout>