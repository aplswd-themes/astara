---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import { PageVariantSwitcher } from '../components/interactive/PageVariantSwitcher';
import '../styles/global.css';

const serviceVariants = [
  { label: 'Main', path: '/services' },
  { label: 'Minimalist v1', path: '/services-v1' },
  { label: 'Creative v2', path: '/services-v2' },
  { label: 'Dark Tech v3', path: '/services-v3' },
  { label: 'Editorial v4', path: '/services-v4' },
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Services - V2</title>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased overflow-x-hidden">
  <PreviewNavbar client:load variationName="Creative v2" variations={[{label:'Services (Main)',href:'/services'},{label:'Minimalist v1',href:'/services-v1'},{label:'Creative v2',href:'/services-v2'},{label:'Dark Tech v3',href:'/services-v3'},{label:'Editorial v4',href:'/services-v4'}]} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500">Capabilities</h1>
      <p class="text-lg text-slate-600 font-medium">Specialized disciplines focused on product outcomes.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[240px]">
      <div class="group relative md:col-span-2 row-span-2 rounded-3xl p-8 overflow-hidden bg-white shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-purple-50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col h-full justify-end">
          <div class="mb-auto p-4 bg-white/80 backdrop-blur rounded-2xl w-fit border border-slate-100 shadow-sm">
            <svg class="w-8 h-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h2 class="text-3xl font-bold mb-3">Product Engineering</h2>
          <p class="text-slate-600 max-w-md">End-to-end development of web and mobile applications using modern frameworks.</p>
        </div>
      </div>
      
      <div class="group relative rounded-3xl p-8 overflow-hidden bg-white shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-tr from-rose-50 to-orange-50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10">
          <h3 class="text-xl font-bold mb-2">Design Systems</h3>
          <p class="text-sm text-slate-500">Component libraries and documentation.</p>
        </div>
      </div>
      
      <div class="group relative rounded-3xl p-8 overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 text-white shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02]">
        <div class="relative z-10 flex flex-col h-full justify-between">
          <h3 class="text-xl font-bold">Data Analytics</h3>
          <p class="text-sm text-slate-300">Pipeline construction and dashboarding.</p>
        </div>
      </div>
      
      <div class="group relative md:col-span-3 rounded-3xl p-8 overflow-hidden bg-white shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-50 to-teal-50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between h-full gap-8">
          <div>
            <h2 class="text-3xl font-bold mb-3">Cloud Infrastructure</h2>
            <p class="text-slate-600 max-w-xl">Managed hosting, container orchestration, and serverless deployment strategies.</p>
          </div>
          <button class="px-6 py-3 rounded-full bg-slate-900 text-white font-medium hover:bg-slate-800 transition-colors shrink-0">Explore Infra</button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>



