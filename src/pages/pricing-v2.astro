---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import LogoCloud from '../components/sections/LogoCloud.astro';
import { FAQ } from '../components/sections/FAQ';
import CTABanner from '../components/sections/CTABanner.astro';
import '../styles/global.css';

const clientLogos = [{ name: 'Vercel' }, { name: 'Stripe' }, { name: 'Linear' }, { name: 'GitHub' }, { name: 'Figma' }];
const pricingFaqs = [
  { question: 'What is included in the free trial?', answer: 'The free trial gives you full access to all Pro features for 14 days.' },
  { question: 'Can I cancel my subscription?', answer: 'Yes, cancel anytime directly from your dashboard.' },
];
---
<html lang="en">
<head><title>Pricing - Creative</title></head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased overflow-x-hidden">
  <PreviewNavbar client:load variationName="Creative v2" variations={[{label:'Pricing (Main)',href:'/pricing'},{label:'Minimalist v1',href:'/pricing-v1'},{label:'Creative v2',href:'/pricing-v2'},{label:'Dark Tech v3',href:'/pricing-v3'},{label:'Editorial v4',href:'/pricing-v4'}]} />
    
    <div class="absolute inset-0 z-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-100 via-purple-50 to-white h-screen"></div>
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 pb-20">
        <div class="text-center max-w-3xl mx-auto mb-24">
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 pb-2">Simple pricing.</h1>
            <p class="mt-6 text-xl text-slate-600 font-medium">Choose the plan that works for you.</p>
        </div>
        <div class="flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-0 mt-16 mb-32">
            <!-- Plan 1 -->
            <div class="w-full lg:w-1/3 bg-white/60 backdrop-blur-xl rounded-3xl p-10 border border-white/50 shadow-xl hover:shadow-2xl transition-all duration-300 z-10 hover:scale-105">
                <h3 class="text-2xl font-bold text-slate-800">Starter</h3>
                <div class="mt-4 text-5xl font-extrabold text-slate-900">$12<span class="text-lg font-medium text-slate-500">/mo</span></div>
                <p class="mt-4 text-slate-600">Perfect for individuals starting out.</p>
                <ul class="mt-8 space-y-4">
                    <li class="flex items-center text-slate-700">
                        <svg class="w-5 h-5 text-indigo-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        1 User
                    </li>
                    <li class="flex items-center text-slate-700">
                        <svg class="w-5 h-5 text-indigo-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        10 Projects
                    </li>
                </ul>
                <button class="mt-10 w-full bg-slate-100 text-slate-900 font-bold py-3 rounded-xl hover:bg-slate-200 transition-colors">Start Free Trial</button>
            </div>
            
            <!-- Plan 2 (Featured) -->
            <div class="w-full lg:w-1/3 bg-gradient-to-br from-indigo-600 to-purple-700 rounded-3xl p-12 shadow-2xl shadow-purple-500/30 text-white z-20 transform scale-105 hover:scale-110 transition-all duration-300">
                <div class="flex justify-between items-center">
                    <h3 class="text-2xl font-bold">Pro</h3>
                    <span class="px-3 py-1 bg-white/20 text-sm font-semibold rounded-full backdrop-blur-md">Popular</span>
                </div>
                <div class="mt-4 text-6xl font-extrabold">$29<span class="text-xl font-medium text-white/70">/mo</span></div>
                <p class="mt-4 text-indigo-100">For professional teams scaling up.</p>
                <ul class="mt-8 space-y-4">
                    <li class="flex items-center text-white">
                        <svg class="w-5 h-5 text-indigo-200 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Up to 5 Users
                    </li>
                    <li class="flex items-center text-white">
                        <svg class="w-5 h-5 text-indigo-200 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Unlimited Projects
                    </li>
                    <li class="flex items-center text-white">
                        <svg class="w-5 h-5 text-indigo-200 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Advanced Analytics
                    </li>
                </ul>
                <button class="mt-10 w-full bg-white text-indigo-600 font-bold py-4 rounded-xl hover:bg-indigo-50 transition-colors shadow-lg shadow-white/10">Get Started</button>
            </div>

            <!-- Plan 3 -->
            <div class="w-full lg:w-1/3 bg-white/60 backdrop-blur-xl rounded-3xl p-10 border border-white/50 shadow-xl hover:shadow-2xl transition-all duration-300 z-10 hover:scale-105">
                <h3 class="text-2xl font-bold text-slate-800">Team</h3>
                <div class="mt-4 text-5xl font-extrabold text-slate-900">$79<span class="text-lg font-medium text-slate-500">/mo</span></div>
                <p class="mt-4 text-slate-600">For large organizations.</p>
                <ul class="mt-8 space-y-4">
                    <li class="flex items-center text-slate-700">
                        <svg class="w-5 h-5 text-purple-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Unlimited Users
                    </li>
                    <li class="flex items-center text-slate-700">
                        <svg class="w-5 h-5 text-purple-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Custom Integrations
                    </li>
                    <li class="flex items-center text-slate-700">
                        <svg class="w-5 h-5 text-purple-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Priority Support
                    </li>
                </ul>
                <button class="mt-10 w-full bg-slate-100 text-slate-900 font-bold py-3 rounded-xl hover:bg-slate-200 transition-colors">Contact Sales</button>
            </div>
        </div>

        <LogoCloud label="Brands we love" logos={clientLogos} dark={false} />
        <FAQ client:load title="Got Questions?" items={pricingFaqs} dark={false} />
        <CTABanner headline="Let's create something beautiful together." primaryCta={{ label: 'Start Free Trial', href: '/contact' }} />
    </main>
</body>
</html>