---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import '../styles/global.css';

const featuredPost = {
  title: "Building the Next Generation of E-commerce Experiences",
  excerpt: "The landscape of online shopping is shifting. We explore how headless architecture, personalization algorithms, and immersive 3D product views are fundamentally changing how consumers interact with brands online.",
  category: "Engineering",
  date: "March 20, 2024",
  readTime: "10 min read",
  author: { name: "David Kim" },
  href: "/blog/future-of-ai-design",
};

const blogPosts = [
  { title: 'The Future of AI in Product Design', category: 'Design', date: 'March 15, 2024', href: '/blog/future-of-ai-design' },
  { title: 'Building Scalable APIs with Node.js', category: 'Engineering', date: 'March 10, 2024', href: '/blog/future-of-ai-design' },
  { title: '10 UX Principles Every Designer Should Know', category: 'Design', date: 'March 05, 2024', href: '/blog/future-of-ai-design' },
  { title: 'How We Reduced Load Time by 60%', category: 'Engineering', date: 'February 28, 2024', href: '/blog/future-of-ai-design' }
];
---
<html lang="en">
<head><title>Blog - Dark Tech</title></head>
<body class="bg-zinc-950 text-zinc-300 font-sans antialiased overflow-x-hidden selection:bg-blue-500/30">
  <PreviewNavbar client:load variationName="Dark Tech v3" variations={[{label:'Blog (Main)',href:'/blog'},{label:'Minimalist v1',href:'/blog-v1'},{label:'Creative v2',href:'/blog-v2'},{label:'Dark Tech v3',href:'/blog-v3'},{label:'Editorial v4',href:'/blog-v4'}]} />
  
  <div class="fixed inset-0 z-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMyIgY3k9IjMiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-50"></div>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-32 relative z-10">
    <header class="mb-20 border-b border-zinc-800 pb-12">
      <div class="text-blue-500 font-mono text-sm mb-4">&gt; cd /blog/latest</div>
      <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tighter mb-4">Engineering Blog</h1>
      <p class="text-xl text-zinc-500">System design, performance, and architecture.</p>
    </header>

    <div class="mb-24">
      <a href={featuredPost.href} class="block group relative bg-zinc-900 border border-zinc-800 p-8 md:p-12 rounded-2xl hover:border-blue-500/50 transition-colors">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl"></div>
        <div class="relative z-10 flex flex-col lg:flex-row gap-12 items-center">
          <div class="w-full lg:w-1/2 aspect-video bg-zinc-950 rounded-xl border border-zinc-800 flex items-center justify-center relative overflow-hidden">
             <div class="absolute inset-0 bg-blue-500/10 group-hover:bg-blue-500/20 transition-colors"></div>
             <div class="w-16 h-16 rounded-full bg-blue-500/20 flex items-center justify-center shadow-[0_0_30px_rgba(59,130,246,0.3)]">
                <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
             </div>
          </div>
          <div class="w-full lg:w-1/2">
            <div class="flex items-center gap-4 mb-4 font-mono text-xs text-zinc-400 uppercase">
              <span class="text-blue-400">{featuredPost.category}</span>
              <span>{featuredPost.date}</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 group-hover:text-blue-400 transition-colors leading-tight">{featuredPost.title}</h2>
            <p class="text-zinc-400 mb-8">{featuredPost.excerpt}</p>
            <div class="text-sm text-zinc-500 font-mono">By {featuredPost.author.name}</div>
          </div>
        </div>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {blogPosts.map((post) => (
        <a href={post.href} class="block group bg-zinc-900/50 border border-zinc-800 p-8 rounded-xl hover:bg-zinc-900 hover:border-zinc-700 transition-all">
          <div class="font-mono text-xs text-blue-500 mb-3">{post.category} // {post.date}</div>
          <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">{post.title}</h3>
        </a>
      ))}
    </div>
  </main>
</body>
</html>