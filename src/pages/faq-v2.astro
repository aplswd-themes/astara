---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';
import { AnimatedFAQ } from '../components/sections/AnimatedFAQ';

const faqVariants = [
  { label: 'FAQ (Main)', href: '/faq' },
  { label: 'Animated Split v2', href: '/faq-v2' },
  { label: 'Modern Grid v3', href: '/faq-v3' }
];

const allFaqs = [
  { question: "What is Nexus?", answer: "Nexus is a comprehensive digital platform designed to help businesses manage their operations and online presence. It provides all the essential tools you need in one unified dashboard." },
  { question: "How does pricing work?", answer: "Our pricing is subscription-based, offering monthly and annual billing cycles. You only pay for the features and capacity you need, with transparent tiering that scales with your business." },
  { question: "Do you offer a free trial?", answer: "Yes, we offer a 14-day full-featured free trial so you can evaluate the platform. No credit card is required to start your trial." },
  { question: "How do I get started?", answer: "Getting started is simple. Just create an account, choose your preferred template, and follow our step-by-step onboarding guide to set up your first project within minutes." },
  { question: "What industries do you serve?", answer: "We serve a wide variety of industries including e-commerce, software development, creative agencies, and professional services. Our flexible platform adapts to different business models easily." },
];
---

<BaseLayout themeSlug="software">
  <PreviewNavbar client:load variationName="Animated Split v2" variations={faqVariants} />
  
  <div class="min-h-screen bg-white">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        <div class="lg:col-span-5 sticky top-32">
          <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-zinc-900 mb-6 leading-tight">Got Questions? <br/> <span class="text-indigo-600">We've got answers.</span></h1>
          <p class="text-xl text-zinc-500 font-medium mb-10">Everything you need to know about the product and billing. If you can't find what you're looking for, feel free to reach out.</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-zinc-900 text-white font-bold hover:bg-zinc-800 transition-colors">
            Contact Support
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
        
        <div class="lg:col-span-7">
          <AnimatedFAQ items={allFaqs} variant="split" client:load />
        </div>
      </div>
    </main>
  </div>
  
  <Footer />
</BaseLayout>
