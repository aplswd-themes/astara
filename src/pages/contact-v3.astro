---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

const contactVariants = [
  { label: 'Contact (Main)', href: '/contact' },
  { label: 'Minimalist v1', href: '/contact-v1' },
  { label: 'Creative v2', href: '/contact-v2' },
  { label: 'Dark Tech v3', href: '/contact-v3' }
];

const footerColumns = [{ title: 'Company', links: [{ label: 'About Us', href: '/about' }] }];
---

<BaseLayout title="Contact - Dark Tech" themeSlug="ecommerce">
  <PreviewNavbar client:load variationName="Dark Tech v3" variations={contactVariants} />

  <main class="flex-1 bg-zinc-950 text-zinc-300 font-sans selection:bg-blue-500/30 pb-32">
    <div class="fixed inset-0 z-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMyIgY3k9IjMiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-50 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-32 relative z-10">
      <header class="mb-20 text-center">
        <div class="text-blue-500 font-mono text-sm mb-4 inline-block px-4 py-1 border border-blue-500/30 rounded bg-blue-500/10">ping --hello nexus.com</div>
        <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tighter mb-4">Initialize Connection</h1>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5 grid grid-cols-1 gap-6">
          <div class="group relative bg-zinc-900/80 border border-zinc-800 p-8 rounded-2xl hover:border-blue-500/50 transition-colors backdrop-blur-md">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl"></div>
            <div class="text-blue-500 font-mono text-xs mb-3">sys.protocol.email</div>
            <h3 class="text-2xl font-bold text-white mb-2">Email</h3>
            <p class="text-zinc-500 font-mono mb-4">hello@nexus.com</p>
          </div>
          <div class="group relative bg-zinc-900/80 border border-zinc-800 p-8 rounded-2xl hover:border-blue-500/50 transition-colors backdrop-blur-md">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl"></div>
            <div class="text-blue-500 font-mono text-xs mb-3">sys.protocol.voice</div>
            <h3 class="text-2xl font-bold text-white mb-2">Phone</h3>
            <p class="text-zinc-500 font-mono mb-4">+1 555 0123</p>
          </div>
        </div>

        <div class="lg:col-span-7 relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-3xl blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
          <div class="relative bg-zinc-900 border border-zinc-800 rounded-3xl p-10 md:p-12 h-full flex flex-col">
            <div class="flex gap-2 mb-8 border-b border-zinc-800 pb-4">
               <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
               <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
               <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
            </div>
            <form class="flex flex-col gap-6 flex-1">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-mono text-zinc-400 mb-2">var name =</label>
                  <input type="text" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none" placeholder='"John Doe"' />
                </div>
                <div>
                  <label class="block text-xs font-mono text-zinc-400 mb-2">var email =</label>
                  <input type="email" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none" placeholder='"john@xyz.com"' />
                </div>
              </div>
              <div class="flex-1 flex flex-col">
                <label class="block text-xs font-mono text-zinc-400 mb-2">var message =</label>
                <textarea class="w-full flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white font-mono focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all outline-none resize-none min-h-[150px]" placeholder='"..."'></textarea>
              </div>
              <button type="button" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-mono font-bold py-4 rounded-lg transition-colors shadow-[0_0_20px_rgba(59,130,246,0.2)]">
                > execute_send()
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer columns={footerColumns} />
</BaseLayout>