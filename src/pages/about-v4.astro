---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About v4 - Editorial</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-[#F9F9F8] text-[#1A1A1A] antialiased">`n  <PreviewNavbar client:load variationName="Editorial v4" />
  
  <nav class="p-8 flex justify-between items-center text-sm uppercase tracking-widest border-b border-black/10">
    <span class="font-medium">Studio</span>
    <span class="text-black/50">Paris / New York</span>
  </nav>

  <main class="max-w-screen-2xl mx-auto px-8 md:px-16 py-32">
    
    <header class="max-w-4xl mb-40">
      <p class="text-sm uppercase tracking-widest text-black/50 mb-8">The Studio</p>
      <h1 class="font-serif text-5xl md:text-7xl leading-tight font-normal text-[#1A1A1A]">
        Curating spaces and objects of lasting significance.
      </h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24 items-start mb-40">
      <div class="md:col-span-5 md:col-start-2">
        <p class="text-lg leading-relaxed font-light text-black/70">
          We operate at the intersection of architecture, interior design, and visual arts. Our approach is grounded in the careful selection of materials and a deep respect for spatial proportions.
        </p>
        <p class="text-lg leading-relaxed font-light text-black/70 mt-6">
          Every project is an exercise in restraint. We remove the superfluous to reveal the essential character of a space.
        </p>
      </div>
      <div class="md:col-span-4">
        <img src="https://images.unsplash.com/photo-1600607686527-6fb886090705?q=80&w=2000&auto=format&fit=crop" alt="Minimalist interior" class="w-full aspect-[3/4] object-cover grayscale hover:grayscale-0 transition-all duration-700" />
      </div>
    </div>

    <!-- Masonry Grid -->
    <div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8">
      <div class="break-inside-avoid">
        <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=1000&auto=format&fit=crop" alt="Architecture detail" class="w-full object-cover" />
      </div>
      <div class="break-inside-avoid">
        <div class="bg-white p-12 aspect-square flex items-center justify-center text-center">
          <p class="font-serif text-2xl italic">"Form follows feeling."</p>
        </div>
      </div>
      <div class="break-inside-avoid">
        <img src="https://images.unsplash.com/photo-1541123356219-284ebe98ae3b?q=80&w=1000&auto=format&fit=crop" alt="Texture detail" class="w-full object-cover" />
      </div>
      <div class="break-inside-avoid">
        <img src="https://images.unsplash.com/photo-1615873968403-89e068629265?q=80&w=1000&auto=format&fit=crop" alt="Furniture detail" class="w-full object-cover" />
      </div>
    </div>

    <footer class="mt-40 pt-16 border-t border-black/10 flex flex-col md:flex-row justify-between items-start md:items-end text-sm">
      <div class="mb-8 md:mb-0">
        <p class="uppercase tracking-widest text-black/50 mb-2">Inquiries</p>
        <a href="mailto:contact@studio.com" class="text-lg hover:italic transition-all">contact@studio.com</a>
      </div>
      <p class="text-black/50">© 2026 Studio. All rights reserved.</p>
    </footer>

  </main>
</body>
</html>


