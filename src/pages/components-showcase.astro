---
import HeaderV1 from '../components/layout/HeaderV1.astro';
import HeaderV2 from '../components/layout/HeaderV2.astro';
import HeaderV3 from '../components/layout/HeaderV3.astro';
import HeaderV4 from '../components/layout/HeaderV4.astro';
import HeaderV5 from '../components/layout/HeaderV5.astro';
import FooterV1 from '../components/layout/FooterV1.astro';
import FooterV2 from '../components/layout/FooterV2.astro';
import FooterV3 from '../components/layout/FooterV3.astro';
import FooterV4 from '../components/layout/FooterV4.astro';
import FooterV5 from '../components/layout/FooterV5.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Components Showcase</title>
	</head>
	<body class="bg-zinc-100 min-h-screen pb-20">
		<div class="max-w-7xl mx-auto pt-10">
			<h1 class="text-4xl font-extrabold text-center mb-16">Components Showcase</h1>
			
			<h2 class="text-2xl font-bold p-8">Header V1</h2>
			<div class="relative transform bg-white mb-8 border">
				<HeaderV1 />
			</div>

			<h2 class="text-2xl font-bold p-8">Header V2</h2>
			<div class="relative transform bg-white mb-8 border">
				<HeaderV2 />
			</div>

			<h2 class="text-2xl font-bold p-8">Header V3</h2>
			<div class="relative transform bg-white mb-8 border">
				<HeaderV3 />
			</div>

			<h2 class="text-2xl font-bold p-8">Header V4</h2>
			<div class="relative transform bg-white mb-16 border">
				<HeaderV4 />
			</div>

			<h2 class="text-2xl font-bold p-8">Header V5</h2>
			<div class="relative transform bg-white mb-16 border">
				<HeaderV5 />
			</div>

			<h2 class="text-2xl font-bold p-8">Footer V1</h2>
			<div class="bg-white mb-8 border">
				<FooterV1 />
			</div>

			<h2 class="text-2xl font-bold p-8">Footer V2</h2>
			<div class="bg-white mb-8 border">
				<FooterV2 />
			</div>

			<h2 class="text-2xl font-bold p-8">Footer V3</h2>
			<div class="bg-white mb-8 border">
				<FooterV3 />
			</div>

			<h2 class="text-2xl font-bold p-8">Footer V4</h2>
			<div class="bg-white mb-8 border">
				<FooterV4 />
			</div>

			<h2 class="text-2xl font-bold p-8">Footer V5</h2>
			<div class="bg-white mb-8 border">
				<FooterV5 />
			</div>
		</div>
	</body>
</html>
