---
import { PreviewNavbar } from '../components/layout/PreviewNavbar';
import LogoCloud from '../components/sections/LogoCloud.astro';
import { FAQ } from '../components/sections/FAQ';
import CTABanner from '../components/sections/CTABanner.astro';
import '../styles/global.css';

const clientLogos = [{ name: 'Vercel' }, { name: 'Stripe' }, { name: 'Linear' }, { name: 'GitHub' }, { name: 'Figma' }];
const pricingFaqs = [
  { question: 'What is included in the free trial?', answer: 'The free trial gives you full access to all Pro features for 14 days.' },
  { question: 'Can I cancel my subscription?', answer: 'Yes, cancel anytime directly from your dashboard.' },
];
---
<html lang="en">
<head><title>Pricing - Dark Tech</title></head>
<body class="bg-zinc-950 text-zinc-300 font-sans antialiased overflow-x-hidden">
  <PreviewNavbar client:load variationName="Dark Tech v3" variations={[{label:'Pricing (Main)',href:'/pricing'},{label:'Minimalist v1',href:'/pricing-v1'},{label:'Creative v2',href:'/pricing-v2'},{label:'Dark Tech v3',href:'/pricing-v3'},{label:'Editorial v4',href:'/pricing-v4'}]} />
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 pb-12">
        <header class="text-center mb-20 relative">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-blue-500/10 blur-[120px] rounded-full pointer-events-none"></div>
            <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tighter mb-4 relative z-10">Scalable Pricing</h1>
            <p class="text-zinc-400 text-xl relative z-10">Predictable pricing for modern engineering teams.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-32 relative z-10">
            <div class="group relative rounded-3xl bg-zinc-900/50 border border-zinc-800/80 p-10 hover:border-zinc-700 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-blue-900/10 backdrop-blur-sm">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity rounded-3xl pointer-events-none"></div>
                <h3 class="text-2xl font-bold text-white mb-2">Standard</h3>
                <p class="text-zinc-400 mb-8 font-medium">Core features for small teams.</p>
                <div class="text-5xl font-bold text-white mb-8">$15<span class="text-xl text-zinc-500 font-medium">/seat/mo</span></div>
                <ul class="space-y-4 text-base mb-10 font-medium">
                    <li class="flex items-center text-zinc-300">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-4"></div> Up to 10 users
                    </li>
                    <li class="flex items-center text-zinc-300">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-4"></div> Standard analytics
                    </li>
                </ul>
                <button class="w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold py-4 rounded-xl transition-colors ring-1 ring-inset ring-white/10">Start Standard</button>
            </div>

            <div class="group relative rounded-3xl bg-zinc-900 border border-blue-500/30 p-10 shadow-[0_0_50px_-12px_rgba(59,130,246,0.25)] hover:border-blue-500/60 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_0_60px_-12px_rgba(59,130,246,0.4)] overflow-hidden">
                <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-500 to-purple-500"></div>
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent rounded-3xl pointer-events-none"></div>
                
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-2xl font-bold text-white">Plus</h3>
                    <span class="px-3 py-1 bg-blue-500/20 text-blue-300 text-xs font-bold uppercase tracking-widest rounded-full border border-blue-500/30">Recommended</span>
                </div>
                
                <p class="text-zinc-400 mb-8 font-medium">Advanced workflows and reporting.</p>
                <div class="text-5xl font-bold text-white mb-8">$45<span class="text-xl text-zinc-500 font-medium">/seat/mo</span></div>
                <ul class="space-y-4 text-base mb-10 font-medium">
                    <li class="flex items-center text-zinc-300">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-400 mr-4"></div> Unlimited users
                    </li>
                    <li class="flex items-center text-zinc-300">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-400 mr-4"></div> Advanced analytics
                    </li>
                    <li class="flex items-center text-zinc-300">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-400 mr-4"></div> Custom roles
                    </li>
                </ul>
                <button class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-xl transition-colors shadow-lg shadow-blue-500/25">Start Plus</button>
            </div>
        </div>
    </main>

    <LogoCloud label="Powering the best" logos={clientLogos} dark={true} />
    <FAQ client:load title="Technical FAQ" items={pricingFaqs} dark={true} />
    <CTABanner headline="Deploy instantly. Scale infinitely." primaryCta={{ label: 'Start Free Trial', href: '/contact' }} />
</body>
</html>