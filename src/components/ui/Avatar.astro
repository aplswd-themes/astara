---
/**
 * Avatar.astro
 * ────────────
 * Displays a user's profile picture or initials.
 *
 * @example
 * <Avatar src="/images/user.jpg" alt="John Doe" size="md" />
 * <Avatar fallback="JD" size="lg" />
 */

interface Props {
  src?: string;
  alt?: string;
  fallback?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { src, alt = '', fallback = '?', size = 'md', class: className = '' } = Astro.props;

const sizeStyles = {
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-12 h-12 text-base',
  xl: 'w-16 h-16 text-lg',
};
---

<div
  class={`relative inline-flex items-center justify-center overflow-hidden bg-zinc-200 text-zinc-600 rounded-full shrink-0 ${sizeStyles[size]} ${className}`}
>
  {src ? (
    <img src={src} alt={alt} class="w-full h-full object-cover" loading="lazy" />
  ) : (
    <span class="font-medium uppercase">{fallback}</span>
  )}
</div>
