---
// HeaderV5.astro (Classy Modern & Professional)
---
<header class="w-full bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 bg-slate-900 rounded-sm flex items-center justify-center">
        <span class="text-white font-serif font-bold text-lg">E</span>
      </div>
      <span class="text-xl font-medium tracking-wide text-slate-900">Enterprise</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Platform</a>
      <a href="/solutions" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Solutions</a>
      <a href="/resources" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Resources</a>
      <a href="/pricing" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Pricing</a>
    </nav>

    <!-- Actions -->
    <div class="hidden md:flex items-center gap-4">
      <a href="/login" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Sign In</a>
      <a href="/contact" class="px-5 py-2.5 bg-slate-900 text-white text-sm font-medium rounded hover:bg-slate-800 transition-colors shadow-sm">Contact Sales</a>
    </div>

    <!-- Mobile Menu Button -->
    <button class="md:hidden text-slate-900">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>
