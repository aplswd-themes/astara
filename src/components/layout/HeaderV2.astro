---
// HeaderV2.astro (Creative Agency)
---
<div class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none">
  <header class="w-full max-w-4xl bg-white/30 backdrop-blur-xl border border-white/40 rounded-full shadow-lg pointer-events-auto">
    <div class="px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-bold tracking-tight text-gray-900">Agency</a>
      <nav class="hidden md:flex gap-6 items-center">
        <a href="/" class="text-sm font-medium text-gray-700 hover:text-gray-950 transition-colors">Home</a>
        <a href="/about" class="text-sm font-medium text-gray-700 hover:text-gray-950 transition-colors">About</a>
        <a href="/services" class="text-sm font-medium text-gray-700 hover:text-gray-950 transition-colors">Services</a>
        <a href="/contact" class="text-sm font-medium text-gray-700 hover:text-gray-950 transition-colors">Contact</a>
      </nav>
      <a href="/contact" class="hidden md:inline-flex px-5 py-2 rounded-full bg-gradient-to-r from-pink-500 to-violet-500 text-white text-sm font-bold shadow-md hover:scale-105 transition-transform">Get Started</a>
      <button class="md:hidden text-gray-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </header>
</div>
