---
/**
 * Footer.astro
 * -------------
 * Modern, dark-mode specialized footer with glowing gradients and clean typography.
 */

interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Social {
  platform: string;
  href: string;
}

interface Props {
  logo?: string;
  brandName?: string;
  tagline?: string;
  brandDescription?: string;
  columns?: FooterColumn[];
  subnavLinks?: FooterColumn[];
  socials?: Social[];
  socialLinks?: Social[];
  copyright?: string;
  dark?: boolean;
}

const props = Astro.props;
const logoText = props.logo || props.brandName || 'Nexus';
const taglineText = props.tagline || props.brandDescription || 'High-performance architecture for the modern web.';
const activeColumns = props.columns || props.subnavLinks || [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#' },
      { label: 'Integrations', href: '#' },
      { label: 'Pricing', href: '#' },
      { label: 'Changelog', href: '#' }
    ]
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '#' },
      { label: 'Careers', href: '#' },
      { label: 'Blog', href: '#' },
      { label: 'Contact', href: '#' }
    ]
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '#' },
      { label: 'Terms of Service', href: '#' },
      { label: 'Cookie Policy', href: '#' }
    ]
  }
];
const activeSocials = props.socials || props.socialLinks || [
  { platform: 'Twitter', href: '#' },
  { platform: 'GitHub', href: '#' },
  { platform: 'LinkedIn', href: '#' }
];
const copyrightText = props.copyright || `© ${new Date().getFullYear()} ${logoText}. All rights reserved.`;

---

<footer class="bg-zinc-950 text-zinc-400 py-16 md:py-24 border-t border-white/5 relative overflow-hidden">
  {/* Soft background glow */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-indigo-500/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8 mb-16">
      
      {/* Brand Section */}
      <div class="lg:col-span-2 flex flex-col gap-6">
        <a href="/" class="text-3xl font-black tracking-tight text-white flex items-center gap-3 group w-max">
          <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-sm shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform">
            <span class="text-white">⬡</span>
          </span>
          {logoText}
        </a>
        <p class="text-zinc-400 text-lg max-w-sm leading-relaxed">
          {taglineText}
        </p>
        
        {/* Social Icons */}
        <div class="flex items-center gap-3 mt-2">
          {activeSocials.map(s => (
            <a href={s.href} class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400 hover:bg-white/10 hover:text-white hover:border-white/20 transition-all group">
              <span class="text-xs font-bold uppercase tracking-wider group-hover:scale-110 transition-transform">{s.platform.slice(0, 1)}</span>
            </a>
          ))}
        </div>
      </div>

      {/* Navigation Columns */}
      {activeColumns.map(col => (
        <div class="flex flex-col gap-5">
          <h4 class="text-white font-bold tracking-wide">{col.title}</h4>
          <ul class="flex flex-col gap-3">
            {col.links.map(link => (
              <li>
                <a href={link.href} class="text-zinc-400 hover:text-white hover:translate-x-1 transition-all inline-block font-medium">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Bottom Bar */}
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm font-medium">
      <p class="text-zinc-500">{copyrightText}</p>
      <div class="flex items-center gap-6 text-zinc-500">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms</a>
        <a href="/docs" class="hover:text-white transition-colors">Documentation</a>
      </div>
    </div>
  </div>
</footer>
