---
// HeaderV1.astro (Brutalist / Minimalist)
---
<header class="border-b-4 border-black bg-white text-black font-mono">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="/" class="text-3xl font-black uppercase tracking-tighter hover:bg-black hover:text-white px-2 py-1 transition-colors">Logo</a>
    <nav class="hidden md:flex gap-8">
      <a href="/" class="text-lg font-bold uppercase hover:underline decoration-4 underline-offset-4">Home</a>
      <a href="/about" class="text-lg font-bold uppercase hover:underline decoration-4 underline-offset-4">About</a>
      <a href="/services" class="text-lg font-bold uppercase hover:underline decoration-4 underline-offset-4">Services</a>
      <a href="/contact" class="text-lg font-bold uppercase hover:underline decoration-4 underline-offset-4">Contact</a>
    </nav>
    <button class="md:hidden text-2xl font-black uppercase border-2 border-black px-4 py-2 hover:bg-black hover:text-white">Menu</button>
  </div>
</header>
