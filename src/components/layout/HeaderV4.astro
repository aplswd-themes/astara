---
// HeaderV4.astro (High-End Editorial)
---
<header class="w-full bg-[#fdfdfc] text-[#1a1a1a] border-b border-[#e5e5e5] py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <nav class="hidden md:flex items-center gap-8 flex-1">
      <a href="/" class="text-xs uppercase tracking-widest hover:text-[#737373] transition-colors">Home</a>
      <a href="/about" class="text-xs uppercase tracking-widest hover:text-[#737373] transition-colors">About</a>
    </nav>
    
    <div class="flex-shrink-0 text-center">
      <a href="/" class="text-4xl font-serif tracking-tight">E D I T O R I A L</a>
    </div>

    <nav class="hidden md:flex items-center gap-8 flex-1 justify-end">
      <a href="/services" class="text-xs uppercase tracking-widest hover:text-[#737373] transition-colors">Services</a>
      <a href="/contact" class="text-xs uppercase tracking-widest hover:text-[#737373] transition-colors">Contact</a>
    </nav>

    <button class="md:hidden text-xs uppercase tracking-widest border border-[#1a1a1a] px-4 py-2">
      Menu
    </button>
  </div>
</header>
