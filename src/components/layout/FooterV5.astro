---
// FooterV5.astro (Classy Modern & Professional)
---
<footer class="bg-slate-50 border-t border-gray-200 text-slate-600 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      
      <!-- Brand & Mission -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-6">
          <div class="w-8 h-8 bg-slate-900 rounded-sm flex items-center justify-center">
            <span class="text-white font-serif font-bold text-lg">E</span>
          </div>
          <span class="text-xl font-medium tracking-wide text-slate-900">Enterprise</span>
        </a>
        <p class="text-sm leading-relaxed mb-6 max-w-sm">
          Delivering cutting-edge solutions for the modern workforce. We combine elegant design with robust engineering to elevate your business.
        </p>
        <div class="flex items-center gap-4">
          <a href="#" class="text-slate-400 hover:text-slate-900 transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
          </a>
          <a href="#" class="text-slate-400 hover:text-slate-900 transition-colors">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-slate-900 font-semibold mb-4">Platform</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-slate-900 transition-colors">Overview</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Features</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Integrations</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Pricing</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-slate-900 font-semibold mb-4">Company</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-slate-900 transition-colors">About Us</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Blog</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-slate-900 font-semibold mb-4">Legal</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#" class="hover:text-slate-900 transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Terms of Service</a></li>
          <li><a href="#" class="hover:text-slate-900 transition-colors">Cookie Policy</a></li>
        </ul>
      </div>

    </div>

    <div class="pt-8 border-t border-gray-200 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} aPLS Web Development. All rights reserved.</p>
      <div class="mt-4 md:mt-0 flex gap-4">
        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> All systems operational</span>
      </div>
    </div>
  </div>
</footer>
