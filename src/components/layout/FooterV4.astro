---
<footer class="bg-[#FAF9F6] text-[#2C2C2C] border-t border-[#EAE8E3]">
  <div class="max-w-5xl mx-auto px-4 py-24 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center mb-20 text-center">
      <a href="/" class="text-3xl font-serif tracking-widest text-[#1A1A1A] mb-6">
        L'ÉLÉGANCE
      </a>
      <p class="max-w-md text-sm leading-relaxed text-[#5A5A5A] font-light">
        Curating the finest in design, lifestyle, and culture for the modern aesthete. Delivered with uncompromising quality and timeless taste.
      </p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center md:text-left mb-20">
      <div>
        <h4 class="font-serif text-sm tracking-widest uppercase text-[#1A1A1A] mb-6">Sections</h4>
        <ul class="space-y-4 text-sm font-light text-[#5A5A5A]">
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Editorials</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Interviews</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Galleries</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Reviews</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-serif text-sm tracking-widest uppercase text-[#1A1A1A] mb-6">Company</h4>
        <ul class="space-y-4 text-sm font-light text-[#5A5A5A]">
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Masthead</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">About Us</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-serif text-sm tracking-widest uppercase text-[#1A1A1A] mb-6">Follow</h4>
        <ul class="space-y-4 text-sm font-light text-[#5A5A5A]">
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Instagram</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Pinterest</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Twitter</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-serif text-sm tracking-widest uppercase text-[#1A1A1A] mb-6">Legal</h4>
        <ul class="space-y-4 text-sm font-light text-[#5A5A5A]">
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Terms of Use</a></li>
          <li><a href="#" class="hover:text-[#1A1A1A] transition-colors">Cookie Policy</a></li>
        </ul>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row items-center justify-between pt-8 border-t border-[#EAE8E3] text-xs font-light tracking-wide text-[#888888]">
      <p>&copy; {new Date().getFullYear()} L'Élégance Publications.</p>
      <p class="mt-4 md:mt-0">Designed in Paris, Crafted Globally.</p>
    </div>
  </div>
</footer>
