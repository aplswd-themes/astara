        <ul class="space-y-2 font-mono font-medium">
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Twitter</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Instagram</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">LinkedIn</a></li>
        </ul>
      </div>

      <div class="border-l-4 border-black pl-4">
        <h3 class="text-xl font-bold uppercase mb-4">Legal</h3>
