        <ul class="space-y-2 font-mono font-medium">
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Projects</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Case Studies</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Archive</a></li>
