    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 border-b-4 border-black pb-12 mb-8">
      <div class="col-span-1 md:col-span-2 lg:col-span-4">
        <h2 class="text-7xl font-black uppercase tracking-tighter">Brand</h2>
      </div>
      
      <div class="border-l-4 border-black pl-4">
        <h3 class="text-xl font-bold uppercase mb-4">About</h3>
        <ul class="space-y-2 font-mono font-medium">
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Studio</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Philosophy</a></li>
          <li><a href="#" class="hover:underline hover:bg-black hover:text-white px-1">Careers</a></li>
