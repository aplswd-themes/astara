---
/**
 * Testimonials.astro
 * ───────────────────
 * Modern animated grid of customer testimonial quotes.
 */

interface Testimonial {
  quote: string;
  name?: string;
  author?: string;
  role: string;
  avatar?: string;
  rating?: number;
}

interface Props {
  title?: string;
  subtitle?: string;
  testimonials: Testimonial[];
  dark?: boolean;
}

const {
  title = 'What our customers say',
  subtitle = 'Testimonials',
  testimonials = [],
  dark = false,
} = Astro.props;
---

<section class={`py-24 md:py-32 relative z-10 ${dark ? 'bg-zinc-950 text-white' : 'bg-transparent text-zinc-900'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-20 text-center flex flex-col items-center">
      {subtitle && (
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 mb-6 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-indigo-600">
            {subtitle}
          </span>
        </div>
      )}
      {title && (
        <h2 class="text-4xl md:text-5xl font-black tracking-tighter text-zinc-900 mb-8">
          {title}
        </h2>
      )}
    </div>

    <div class="grid grid-cols-1 gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t, i) => {
        const displayName = t.name || t.author || 'Anonymous';
        return (
          <div
            class="group relative flex flex-col p-8 sm:p-10 rounded-[32px] bg-white border border-zinc-200 hover:border-indigo-500/30 overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-indigo-500/10 hover:-translate-y-2 z-10"
            style={`animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: ${i * 100}ms`}
          >
            {/* Ambient Background */}
            <div class="absolute inset-0 bg-gradient-to-bl from-indigo-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"></div>
            
            {/* Quote Icon */}
            <div class="mb-6 opacity-20 group-hover:opacity-100 group-hover:text-indigo-500 transition-all duration-500">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>

            {/* Stars */}
            {(t.rating || 5) > 0 && (
              <div class="flex items-center gap-1 mb-6">
                {Array.from({ length: t.rating || 5 }).map(() => (
                  <svg class="w-4 h-4 text-amber-400 group-hover:text-amber-500 transition-colors" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            )}

            {/* Quote */}
            <blockquote class="text-lg text-zinc-600 leading-relaxed flex-1 mb-8 font-medium">
              "{t.quote}"
            </blockquote>

            {/* Author */}
            <div class="flex items-center gap-4 pt-6 border-t border-zinc-100 group-hover:border-indigo-100 transition-colors">
              {t.avatar ? (
                <div class="relative">
                  <div class="absolute inset-0 bg-indigo-500 rounded-full blur-md opacity-0 group-hover:opacity-40 transition-opacity"></div>
                  <img src={t.avatar} alt={displayName} class="w-12 h-12 rounded-full object-cover relative z-10 border-2 border-white shadow-sm" />
                </div>
              ) : (
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-lg font-bold text-indigo-700 shadow-sm border-2 border-white">
                  {displayName.charAt(0)}
                </div>
              )}
              <div>
                <p class="text-sm font-black text-zinc-900">{displayName}</p>
                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider mt-0.5">{t.role}</p>
              </div>
            </div>
            
            {/* Animated edge line */}
            <div class="absolute top-0 left-0 bottom-0 w-1 bg-gradient-to-b from-indigo-500 to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
        );
      })}
    </div>

  </div>
</section>