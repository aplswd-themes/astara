---
/**
 * ClinicalSpecialtiesMatrix.astro
 * ───────────────────────────────
 * Clean, medical-grade specialty selector with clinical hours,
 * in-network coverage, and direct practitioner booking links.
 */

const specialties = [
  {
    icon: '🩺',
    title: 'Primary & Longevity Medicine',
    description: 'Comprehensive annual physicals, metabolic biomarker tracking, and preventative medicine tailored for lifelong vitality.',
    badge: 'Same-Day Available',
    hours: 'Mon — Fri · 8am – 7pm',
    doctor: 'Dr. Amara Osei, MD',
  },
  {
    icon: '❤️',
    title: 'Cardiovascular Diagnostics',
    description: 'Advanced echocardiography, continuous telemetry monitoring, resting EKG, and lipid profile interventions.',
    badge: 'On-Site Diagnostic Lab',
    hours: 'Tue, Thu, Sat · 9am – 5pm',
    doctor: 'Dr. Lena Fischer, MD',
  },
  {
    icon: '🧠',
    title: 'Neuropsychology & Mental Health',
    description: 'Confidential psychiatric evaluations, cognitive behavioral therapy, executive burnout resolution, and mindfulness therapy.',
    badge: 'Telehealth & In-Person',
    hours: 'Mon — Sat · 9am – 8pm',
    doctor: 'Dr. Rajan Mehta, PhD',
  },
  {
    icon: '👶',
    title: 'Family & Pediatric Wellness',
    description: 'Newborn developmental tracking, pediatric immunization, school health checks, and adolescent wellness consultations.',
    badge: 'Dedicated Children\'s Suite',
    hours: 'Mon — Fri · 8:30am – 6pm',
    doctor: 'Dr. Chloe Laurent, MD',
  },
];
---

<section id="services" class="section py-24 bg-gradient-to-b from-cyan-950/20 to-[var(--color-bg)] border-t border-cyan-100/50">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-700 block mb-2">Integrated Care Units</span>
        <h2 class="text-3xl sm:text-5xl font-black text-zinc-900 tracking-tight">Specialist Medical Departments</h2>
      </div>
      <div class="flex items-center gap-3 text-xs font-semibold text-cyan-800 bg-cyan-50 px-4 py-2 rounded-xl border border-cyan-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        Zero Waiting Room Guarantee (Average &lt; 8 min)
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
      {specialties.map(spec => (
        <div class="p-8 rounded-3xl border border-cyan-100 bg-white hover:border-cyan-400 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-12 h-12 rounded-2xl bg-cyan-50 flex items-center justify-center text-2xl border border-cyan-100 shadow-sm">
                {spec.icon}
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-cyan-50 text-cyan-800 border border-cyan-200">
                {spec.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 group-hover:text-cyan-700 transition-colors mb-2">
              {spec.title}
            </h3>
            <p class="text-xs text-zinc-600 leading-relaxed mb-6">
              {spec.description}
            </p>
          </div>

          <div class="pt-5 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div>
              <p class="font-bold text-zinc-900">{spec.doctor}</p>
              <p class="text-[11px] text-zinc-400">{spec.hours}</p>
            </div>
            <a
              href="#appointment"
              class="px-4 py-2 rounded-xl bg-cyan-700 text-white font-bold text-[11px] text-center hover:bg-cyan-800 transition-colors shadow-sm"
            >
              Book Specialty Consult →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
