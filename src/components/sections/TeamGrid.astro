---
/**
 * TeamGrid.astro
 * ──────────────
 * Responsive grid of team member cards.
 *
 * Props:
 * @prop title    - Section heading
 * @prop subtitle - Eyebrow text
 * @prop members  - Array of team members { name, role, bio, avatar?, socials? }
 * @prop cols     - Number of columns (2 | 3 | 4, default 3)
 * @prop dark     - Use dark background variant
 *
 * @example
 * <TeamGrid
 *   title="Meet Our Team"
 *   members={[{ name: 'Alice', role: 'CEO', bio: '...' }]}
 * />
 */

import Card from '../ui/Card.astro';

interface Social {
  platform: string;
  href: string;
}

interface Member {
  name: string;
  role: string;
  bio: string;
  avatar?: string;
  socials?: Social[];
}

interface Props {
  title: string;
  subtitle?: string;
  members: Member[];
  cols?: 2 | 3 | 4;
  dark?: boolean;
}

const {
  title,
  subtitle,
  members,
  cols = 3,
  dark = false,
} = Astro.props;

const colClasses = {
  2: 'sm:grid-cols-2 lg:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};

// Social icon helpers
function getSocialIcon(platform: string) {
  if (platform.toLowerCase() === 'twitter' || platform.toLowerCase() === 'x') {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
  }
  if (platform.toLowerCase() === 'linkedin') {
    return `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.924 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`;
  }
  return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`;
}
---

<section class={`py-20 ${dark ? 'bg-[var(--color-bg)]' : 'bg-[var(--color-bg-subtle)]'}`}>
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      {subtitle && (
        <span class="text-[var(--color-primary)] font-semibold tracking-wide uppercase text-sm">
          {subtitle}
        </span>
      )}
      <h2 class="text-3xl md:text-4xl font-bold mt-2 text-[var(--color-text)]">
        {title}
      </h2>
    </div>

    <div class={`grid gap-8 grid-cols-1 ${colClasses[cols]}`}>
      {members.map(member => (
        <Card hover padding="lg" class="text-center">
          <div class="mb-6 mx-auto w-24 h-24 rounded-full overflow-hidden border-2 border-[var(--color-border)] bg-[var(--color-bg-muted)] flex items-center justify-center">
            {member.avatar ? (
              <img src={member.avatar} alt={member.name} class="w-full h-full object-cover" />
            ) : (
              <span class="text-3xl font-bold text-[var(--color-text-muted)]">
                {member.name.charAt(0)}
              </span>
            )}
          </div>
          <h3 class="text-xl font-bold text-[var(--color-text)]">{member.name}</h3>
          <p class="text-[var(--color-primary)] font-medium text-sm mt-1">{member.role}</p>
          <p class="text-[var(--color-text-muted)] mt-4 leading-relaxed text-sm">
            {member.bio}
          </p>
          {member.socials && member.socials.length > 0 && (
            <div class="flex justify-center gap-4 mt-6">
              {member.socials.map(social => (
                <a
                  href={social.href}
                  class="text-[var(--color-text-subtle)] hover:text-[var(--color-primary)] transition-colors"
                  aria-label={`${member.name} on ${social.platform}`}
                  set:html={getSocialIcon(social.platform)}
                />
              ))}
            </div>
          )}
        </Card>
      ))}
    </div>
  </div>
</section>
