---
/**
 * TemplateBranchingTree.astro
 * ───────────────────────────
 * Modern visual decision & architecture tree section for the homepage.
 * Renders an animated SVG tree hierarchy connecting the multi-purpose Astro core
 * to the 5 specialized business archetypes with modern hover animations and glassmorphism.
 */

import { themes } from '../../lib/themes';
import ThemeIcon from '../ui/ThemeIcon.astro';

const treeBranches = [
  {
    theme: themes[0], // agency
    tag: 'Design Studio & Art',
    glowClass: '',
    colorHex: '#f59e0b',
    stats: 'Awwwards Site of Year',
    signatureFeature: 'Editorial Grid + Case Study Filter',
    deliverables: ['Zero Layout Shift', 'Art Direction', 'Custom Type', 'Cost Estimator'],
  },
  {
    theme: themes[1], // ecommerce
    tag: 'Curated Retail & Apparel',
    glowClass: '',
    colorHex: '#10b981',
    stats: '3.8x Conversion Rate',
    signatureFeature: 'Shop The Look Canvas + QuickView Bag',
    deliverables: ['Slide Cart Drawer', 'Hotspot Beacons', 'Inventory Urgency', 'Colorways'],
  },
  {
    theme: themes[2], // health
    tag: 'Longevity Clinic & Care',
    glowClass: '',
    colorHex: '#06b6d4',
    stats: '100% Acoustic Chambers',
    signatureFeature: 'Biophilic Sanctuary + Patient Intake Scheduler',
    deliverables: ['LEED Platinum', 'Verified Physicians', 'Wellness Quiz', 'HIPAA Ready'],
  },
  {
    theme: themes[3], // restaurant
    tag: 'Michelin 3-Star Dining',
    glowClass: '',
    colorHex: '#e11d48',
    stats: '3 Michelin Stars',
    signatureFeature: 'Artisanal Carte + Sommelier Wine Pairing',
    deliverables: ['Haute Pâtisserie', 'Wagyu & Lobster', 'Salon Privé', 'Table Booking'],
  },
];
---

<section id="ecosystem-tree" class="py-24 px-6 max-w-7xl mx-auto w-full relative z-10">
  <!-- Section Title -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold mb-4 border border-indigo-500/40 bg-indigo-950/60 text-indigo-300">
      <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
      <span>Modern Decision Tree</span>
    </div>
    <h2 class="text-3xl sm:text-5xl font-black text-zinc-900 tracking-tight">
      One Architecture Tree.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400">
        Four Production Verticals.
      </span>
    </h2>
    <p class="text-sm text-zinc-600 mt-4 leading-relaxed max-w-2xl mx-auto">
      Each vertical branches off the same high-speed Astro core while inheriting bespoke color tokens, typography scales, and tailored interactive React islands.
    </p>
  </div>

  <!-- 5 Branch Cards Grid with Modern Hover Effects -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {treeBranches.map((branch, i) => (
      <div
        class={`group rounded-3xl border border-zinc-200 bg-white shadow-sm hover:shadow-lg p-6 flex flex-col justify-between interactive-hover-lift  ${branch.glowClass} transition-all duration-500 hover:bg-white relative overflow-hidden`}
      >
        <!-- Subtle Glow Orb -->
        <div
          class="absolute -top-12 -right-12 w-32 h-32 rounded-full blur-2xl opacity-20 pointer-events-none group-hover:opacity-40 transition-opacity"
          style={`background: ${branch.colorHex};`}
        ></div>

        <div>
          <!-- Branch Card Top Bar -->
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-zinc-200">
            <div class="flex items-center gap-2.5">
              <div
                class="w-10 h-10 rounded-xl flex items-center justify-center border shadow-md transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3"
                style={`background: ${branch.colorHex}20; border-color: ${branch.colorHex}50; color: ${branch.colorHex};`}
              >
                <ThemeIcon slug={branch.theme.slug} size="sm" />
              </div>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-600 block">
                  Branch #{i + 1}
                </span>
                <span class="text-xs font-extrabold text-zinc-900">
                  {branch.tag}
                </span>
              </div>
            </div>

            <span
              class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border"
              style={`color: ${branch.colorHex}; border-color: ${branch.colorHex}40; background: ${branch.colorHex}15;`}
            >
              {branch.stats}
            </span>
          </div>

          <!-- Title & Description -->
          <h3 class="text-xl font-black text-zinc-900 group-hover:text-zinc-100 transition-colors">
            {branch.theme.name}
          </h3>
          <p class="text-xs text-zinc-600 mt-2 leading-relaxed">
            {branch.theme.description}
          </p>

          <!-- Signature Feature Callout -->
          <div class="mt-4 p-3 rounded-xl bg-zinc-50 border border-zinc-200">
            <span class="text-[10px] uppercase font-bold text-zinc-500 block mb-0.5">Signature Module</span>
            <span class="text-xs font-bold text-zinc-900 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full" style={`background: ${branch.colorHex};`}></span>
              {branch.signatureFeature}
            </span>
          </div>

          <!-- Feature Badges -->
          <div class="flex flex-wrap gap-1.5 mt-4">
            {branch.deliverables.map(del => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-800/60 text-zinc-600 border border-zinc-200">
                ✓ {del}
              </span>
            ))}
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="pt-5 mt-6 border-t border-zinc-200 flex items-center gap-3">
          <a
            href={`/themes/${branch.theme.slug}`}
            class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider text-center text-zinc-900 transition-all shadow-md hover:opacity-95 flex items-center justify-center gap-1"
            style={`background: ${branch.colorHex};`}
          >
            <span>Launch Live</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href={`/downloads/themekit-${branch.theme.slug}-theme.zip`}
            download={`themekit-${branch.theme.slug}-theme.zip`}
            class="download-btn py-2.5 px-3 rounded-xl text-xs font-bold border border-zinc-200 bg-zinc-800/80 hover:bg-zinc-700 text-zinc-700 hover:text-zinc-900 transition-all flex items-center justify-center"
            title={`Download ${branch.theme.name} code (.zip)`}
          >
            <svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
