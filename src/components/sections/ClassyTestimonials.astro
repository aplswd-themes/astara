---
export interface TestimonialItem {
  name: string;
  tagline: string;
  quote: string;
  avatarBg?: string;
  initials?: string;
  avatarImg?: string;
  featured?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: TestimonialItem[];
}

const defaultTestimonials: TestimonialItem[] = [
  {
    name: 'Jordan M.',
    tagline: 'Minimum Effort Maximum Attention',
    quote: 'As one of the top digital growth teams, we leverage this theme system to deploy new dynamic client platforms in record time. With the least effort of a few token tweaks, this gives you the best shot at converting visitors into enterprise clients.',
    avatarBg: 'bg-emerald-100 text-emerald-700',
    avatarImg: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=80',
    initials: 'JM',
  },
  {
    name: 'Juan C.',
    tagline: 'Game Changer',
    quote: 'This platform saves dozens of engineering hours and consistently delivers top-quality creative foundations. Since using this architecture, our team has seen a substantial boost in delivery performance and client satisfaction.',
    avatarBg: 'bg-orange-100 text-orange-700',
    avatarImg: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=160&q=80',
    initials: 'JC',
  },
  {
    name: 'Sam G.',
    tagline: 'Best In Class Architecture',
    quote: 'I wish other design frameworks had this level of clean code, zero slop, and strict CSS variable tokens. Support is extraordinary and the component documentation made handoff to our backend engineers seamless.',
    avatarBg: 'bg-blue-100 text-blue-700',
    avatarImg: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&q=80',
    initials: 'SG',
  },
  {
    name: 'Robert L.',
    tagline: 'Really helped me grow my brand',
    quote: 'Nexus allowed us to run multi-vertical landing campaigns for our high-growth brands. The time it has saved us is hard to overstate, and the best part is that we never have to compromise on visual elegance or accessibility. A top-tier foundation for builders.',
    avatarBg: 'bg-indigo-100 text-indigo-700',
    avatarImg: 'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&w=160&q=80',
    initials: 'RL',
    featured: true,
  },
  {
    name: 'Krystal C.',
    tagline: 'It saved me weeks of setup',
    quote: 'We launched 3 complete niche client sites in under a week. The typography, responsive grids, and interactive React components are fully polished out of the box.',
    avatarBg: 'bg-purple-100 text-purple-700',
    avatarImg: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=160&q=80',
    initials: 'KC',
  },
  {
    name: 'Elena S.',
    tagline: 'Uncompromising Quality',
    quote: 'Clean Astro HTML output with zero client-side javascript overhead where not needed, and blazing fast React islands where interactivity is required. Pure craftsmanship.',
    avatarBg: 'bg-pink-100 text-pink-700',
    avatarImg: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=160&q=80',
    initials: 'ES',
  },
];

const {
  title = 'Testimonials',
  subtitle = 'What Customers Are Saying',
  testimonials = defaultTestimonials,
} = Astro.props;
---

<section class="py-24 bg-[var(--color-bg-subtle)] relative overflow-hidden">
  <!-- Organic pastel ambient shapes matching apls.ai Image 2 -->
  <div class="absolute -top-16 -left-16 w-96 h-96 rounded-full bg-emerald-400/10 blur-3xl pointer-events-none animate-float-slow"></div>
  <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-blue-400/10 blur-3xl pointer-events-none animate-float-reverse"></div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-[var(--color-text)] tracking-tight font-heading mb-3">
        {title}
      </h2>
      <p class="text-lg text-[var(--color-text-muted)] font-medium">
        {subtitle}
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class={`p-8 rounded-3xl border border-[var(--color-border)] bg-[var(--color-bg)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-[var(--color-primary)]/40 flex flex-col justify-between ${t.featured ? 'shadow-lg border-[var(--color-primary)]/30 md:translate-y-[-8px]' : 'shadow-sm'}`}>
          <div>
            <!-- Author Header -->
            <div class="flex items-center gap-4 mb-6">
              <div class="relative w-14 h-14 rounded-full overflow-hidden border-2 border-[var(--color-border)] flex-shrink-0 shadow-sm">
                {t.avatarImg ? (
                  <img src={t.avatarImg} alt={t.name} class="w-full h-full object-cover" />
                ) : (
                  <div class={`w-full h-full flex items-center justify-center font-bold text-sm ${t.avatarBg || 'bg-indigo-100 text-indigo-700'}`}>
                    {t.initials || t.name.slice(0, 2)}
                  </div>
                )}
              </div>

              <div>
                <h4 class="font-extrabold text-lg text-[var(--color-text)] leading-snug">
                  {t.name}
                </h4>
                <p class="text-xs font-semibold text-[var(--color-text-muted)] mt-0.5">
                  {t.tagline}
                </p>
              </div>
            </div>

            <!-- Quote Text -->
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-normal">
              "{t.quote}"
            </p>
          </div>

          <!-- Bottom Trust Star Rating -->
          <div class="flex items-center gap-1 text-amber-400 text-xs mt-6 pt-4 border-t border-[var(--color-border)]/50">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            <span class="text-[11px] text-[var(--color-text-subtle)] font-medium ml-2">Verified Client Review</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
