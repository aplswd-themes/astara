---
/**
 * CTABanner.astro
 * ────────────────
 * Impactful dark gradient CTA section.
 */

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  headline?: string;
  subtitle?: string;
  subheadline?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  variant?: 'primary' | 'dark' | 'gradient';
}

const {
  title,
  headline,
  subtitle,
  subheadline,
  primaryCta,
  secondaryCta,
  variant = 'primary',
} = Astro.props;

const mainTitle = title || headline || 'Ready to build something great?';
const mainSubtitle = subtitle || subheadline || 'Join over 15,000 developers shipping faster.';
---

<section class="py-24 md:py-32 px-4 sm:px-6 relative z-10">
  <div class="max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-[40px] bg-zinc-950 px-6 py-20 sm:px-12 sm:py-24 md:px-20 text-center shadow-2xl">
      {/* Dynamic Background Gradients */}
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 via-purple-500/10 to-transparent"></div>
      <div class="absolute top-0 right-0 -mr-32 -mt-32 w-[600px] h-[600px] bg-indigo-500/20 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-32 -mb-32 w-[500px] h-[500px] bg-fuchsia-500/20 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 flex flex-col items-center">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter text-white mb-6">
          {mainTitle}
        </h2>

        <p class="text-lg md:text-xl text-zinc-400 font-medium max-w-2xl mx-auto mb-12 leading-relaxed">
          {mainSubtitle}
        </p>

        {(primaryCta || secondaryCta) && (
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
            {primaryCta && (
              <a
                href={primaryCta.href}
                class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-8 py-4 bg-white text-zinc-950 font-black rounded-full hover:bg-zinc-100 hover:scale-105 transition-all shadow-[0_0_40px_rgba(255,255,255,0.2)]"
              >
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-8 py-4 border-2 border-white/20 text-white font-bold rounded-full hover:bg-white/10 transition-colors"
              >
                {secondaryCta.label}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>