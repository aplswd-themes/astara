---
/**
 * StatsRow.astro
 * ───────────────
 * Horizontal row of key statistics / social proof numbers.
 *
 * Props:
 * @prop stats - Array of { value, label, prefix?, suffix? }
 * @prop dark  - Dark background variant
 *
 * @example
 * <StatsRow
 *   stats={[
 *     { value: '10,000', label: 'Active users', suffix: '+' },
 *     { value: '99.9', label: 'Uptime SLA', suffix: '%' },
 *     { value: '4.9', label: 'Average rating', suffix: '/5' },
 *     { value: '150', label: 'Countries served', suffix: '+' },
 *   ]}
 * />
 */

interface Stat {
  value: string;
  label: string;
  prefix?: string;
  suffix?: string;
}

interface Props {
  stats: Stat[];
  dark?: boolean;
}

const { stats, dark = false } = Astro.props;
---

<section class={`py-16 border-y border-[var(--color-border)] ${dark ? 'bg-[var(--color-bg-subtle)]' : 'bg-[var(--color-bg-muted)]'}`}>
  <div class="container">
    <dl class={`grid grid-cols-2 gap-8 ${stats.length === 4 ? 'lg:grid-cols-4' : stats.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2'}`}>
      {stats.map((s, i) => (
        <div
          class="text-center"
          style={`animation: fadeInUp 0.5s ease both; animation-delay: ${i * 100}ms`}
        >
          <dt class="text-3xl sm:text-4xl font-extrabold text-[var(--color-primary)] mb-1 tabular-nums">
            {s.prefix && <span>{s.prefix}</span>}
            {s.value}
            {s.suffix && <span>{s.suffix}</span>}
          </dt>
          <dd class="text-sm font-medium text-[var(--color-text-muted)] uppercase tracking-wider">
            {s.label}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
