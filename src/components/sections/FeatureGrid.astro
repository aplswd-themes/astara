---
/**
 * FeatureGrid.astro
 * ──────────────────
 * Professional, classy, animated feature grid.
 */

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  features: Feature[];
  cols?: 2 | 3 | 4;
  centered?: boolean;
  dark?: boolean;
}

const {
  id,
  title,
  subtitle,
  features,
  cols = 3,
  centered = true,
  dark = false,
} = Astro.props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};
---

<section id={id} class={`py-24 md:py-32 relative z-10 ${dark ? 'bg-zinc-950 text-white' : 'bg-transparent text-zinc-900'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {(title || subtitle) && (
      <div class={`mb-20 ${centered ? 'text-center flex flex-col items-center' : ''}`}>
        {subtitle && (
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
            <span class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-primary)]">
              {subtitle}
            </span>
          </div>
        )}
        {title && (
          <h2 class="text-4xl md:text-5xl font-black tracking-tighter text-[var(--color-text)]">
            {title}
          </h2>
        )}
      </div>
    )}

    <div class={`grid grid-cols-1 gap-6 md:gap-8 ${gridCols[cols]}`}>
      {features.map((f, i) => (
        <div
          class="group relative flex flex-col p-8 sm:p-10 rounded-[32px] bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)]/30 overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-[var(--color-primary)]/10 hover:-translate-y-2 z-10"
          style={`animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: ${i * 100}ms`}
        >
          {/* Subtle gradient glow background on hover */}
          <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"></div>
          
          <div class="w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center rounded-2xl bg-[var(--color-bg-subtle)] border border-[var(--color-border)] text-[var(--color-text)] text-2xl mb-8 shadow-sm group-hover:scale-110 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-text-inverse)] group-hover:border-transparent transition-all duration-500 ease-out">
            {f.icon.trim().startsWith('<svg') ? (
              <Fragment set:html={f.icon.replace('<svg', '<svg class="w-6 h-6 sm:w-7 sm:h-7 transition-colors duration-500"')} />
            ) : (
              <span>{f.icon}</span>
            )}
          </div>
          
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--color-text)] tracking-tight mb-4 group-hover:text-[var(--color-primary)] transition-colors duration-300">{f.title}</h3>
          
          <p class="text-[var(--color-text-muted)] leading-relaxed font-medium text-sm sm:text-base">
            {f.description}
          </p>
          
          {/* Animated decorative line at the bottom */}
          <div class="absolute bottom-0 left-10 right-10 h-1 bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-700 ease-out origin-center rounded-t-full opacity-50"></div>
        </div>
      ))}
    </div>

  </div>
</section>