---
/**
 * EcommerceTrustStrip.astro
 * ─────────────────────────
 * Clean, high-converting retail trust and service guarantees strip with detailed
 * micro-guarantees, carbon-neutral shipping metrics, and warranty claims.
 */

const guarantees = [
  {
    icon: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`,
    title: 'Lifetime Structural Warranty',
    desc: 'Machined from non-corrosive alloys. Any manufacturing imperfection replaced immediately with zero questions.',
    tag: 'Guaranteed',
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Carbon-Neutral Express Transit',
    desc: 'Same-day order dispatch across North America & Europe with real-time GPS tracking and recycled packaging.',
    tag: 'Eco-Certified',
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
    title: '30-Day In-Workspace Trial',
    desc: 'Experience our lamps and ergonomic seating in your daily flow. Free return courier pickup if you are not in love.',
    tag: 'Risk-Free',
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: '256-Bit Encrypted Payments',
    desc: 'Verified checkout processing via Apple Pay, Google Pay, and Stripe with multi-factor fraud shielding.',
    tag: 'Encrypted',
  },
];
---

<section class="py-16 bg-emerald-950/5 border-y border-emerald-900/10">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {guarantees.map(g => (
        <div class="p-6 rounded-2xl bg-white border border-zinc-200/80 shadow-sm hover:border-emerald-500/40 hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center">
                <Fragment set:html={g.icon} />
              </div>
              <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200/60">
                {g.tag}
              </span>
            </div>
            <h3 class="text-base font-bold text-zinc-900 mb-2">{g.title}</h3>
            <p class="text-xs text-zinc-500 leading-relaxed">{g.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
