---
interface Logo {
  name: string;
  src?: string;
}

interface Props {
  label?: string;
  logos: Logo[];
  dark?: boolean;
  speed?: number;
}

const { label = 'Trusted by teams at', logos, dark = false, speed = 30 } = Astro.props;

// Duplicate logos for seamless infinite looping
const repeatedLogos = [...logos, ...logos, ...logos, ...logos, ...logos, ...logos];
---

<section class={`py-16 md:py-24 overflow-hidden relative ${dark ? 'bg-zinc-950 text-white' : 'bg-transparent text-zinc-900'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    {label && (
      <div class="flex items-center justify-center gap-4">
        <div class="h-px bg-gradient-to-r from-transparent to-zinc-200 dark:to-zinc-800 flex-1 max-w-[100px]"></div>
        <p class="text-center text-xs font-black uppercase tracking-[0.2em] text-zinc-400">
          {label}
        </p>
        <div class="h-px bg-gradient-to-l from-transparent to-zinc-200 dark:to-zinc-800 flex-1 max-w-[100px]"></div>
      </div>
    )}
  </div>

  <div class="relative w-full overflow-hidden select-none flex">
    {/* Gradient edge fade masks */}
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-32 md:w-64 z-10 bg-gradient-to-r from-zinc-50 dark:from-zinc-950 to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-32 md:w-64 z-10 bg-gradient-to-l from-zinc-50 dark:from-zinc-950 to-transparent"></div>

    <div
      class="flex items-center gap-12 sm:gap-24 w-max animate-marquee hover:[animation-play-state:paused]"
      style={`--marquee-speed: ${speed}s;`}
    >
      {repeatedLogos.map((logo) => (
        <div class="flex items-center gap-3 shrink-0 opacity-40 hover:opacity-100 transition-all duration-300 hover:scale-110 cursor-default grayscale hover:grayscale-0">
          {logo.src ? (
            <img
              src={logo.src}
              alt={logo.name}
              class="h-8 md:h-10 object-contain"
              loading="lazy"
            />
          ) : (
            <span class="text-2xl md:text-3xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-br from-zinc-400 to-zinc-600 hover:from-indigo-500 hover:to-purple-500 transition-all">
              {logo.name}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee var(--marquee-speed, 30s) linear infinite;
  }
</style>